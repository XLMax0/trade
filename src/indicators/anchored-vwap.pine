// © liquid-trader

// Enhanced version: Adds Buy/Sell signals (Crossover + Mean Reversion), hybrid TP/SL (VWAP bands + ATR),
// detailed statistics panel, and alert conditions to the original Anchored VWAP indicator.
// Original: https://www.tradingview.com/script/72stxVxI-Anchored-VWAP-Auto-High-Low/

//@version=6
indicator("AVWAP Trading System", "AVWAP Trading System", overlay=true, max_bars_back=0, max_labels_count=500, max_lines_count=500)
import liquid-trader/UtilityLibrary/5 as util


// ---------------------------------------------------- SETTINGS ---------------------------------------------------- {

// Base Colors
const color none = color.new(color.black, 100), const color clr1 = color.aqua

// Groups & Average Types
const string g1 = "High / Low Anchored VWAP", const string g2 = "Daily VWAP", const string g3 = "Time Weighted Average Price", const string g4 = "Market Hours", const string g5 = "Signals", const string g6 = "Take Profit / Stop Loss", const string g7 = "Statistics Panel", const string O = "open", const string H = "high", const string L = "low", const string C = "close", const string HL2 = "hl2", const string HLC3 = "hlc3", const string OHLC4 = "ohlc4", const string HLCC4 = "hlcc4"

// High Anchor
shoHiA = input.bool(true, "High Anchor           ", "VWAP anchored and weighted to trend highs.", inline="hi", group=g1, display=display.none)
hiAnClr = input.color(clr1, "", inline="hi", group=g1, display=display.none)
hiWidth = input.int(2, "", 1, inline="hi", group=g1, display=display.none)
hiAvg = input.string(H, "", [O,H,L,C,HL2, HLC3, OHLC4, HLCC4], inline="hi", group=g1, display=display.none)

// Low Anchor
shoLoA = input.bool(true, "Low Anchor            ", "VWAP anchored and weighted to trend lows.", inline="lo", group=g1, display=display.none)
loAnClr = input.color(clr1, "", inline="lo", group=g1, display=display.none)
loWidth = input.int(2, "", 1, inline="lo", group=g1, display=display.none)
loAvg = input.string(L, "", [O,H,L,C,HL2, HLC3, OHLC4, HLCC4], inline="lo", group=g1, display=display.none)

// Average of Anchors
shoMid = input.bool(true, "Avg. of Anchors     ", "The mean (average) between the high and low anchored VWAP's", inline="mid", group=g1, display=display.none)
midClr = input.color(color.new(clr1, 50), "", inline="mid", group=g1, display=display.none)
mWidth = input.int(2, "", 1, inline="mid", group=g1, display=display.none)

// Quarter levels
shoQrt = input.bool(false, "Quarter Values       ", "The median (middle) value between the mean (average) and high / low anchors.", inline="quarter", group=g1, display=display.none)
qrtClr = input.color(color.new(clr1, 80), "", inline="quarter", group=g1, display=display.none)
qWidth = input.int(1,"", 1, inline="quarter", group=g1, display=display.none)

// High eighth levels with fill
shoHiFil = input.bool(true, "High Interim Bands",  inline="hiFill", group=g1, display=display.none)
hiEthClr = input.color(color.new(clr1, 93), "", inline="hiFill", group=g1, display=display.none)
hiFilClr = input.color(color.new(clr1, 97), "", inline="hiFill", group=g1, display=display.none)

// Low eighth levels with fill
shoLoFil = input.bool(true, "Low Interim Bands ",  inline="loFill", group=g1, display=display.none)
loEthClr = input.color(color.new(clr1, 93), "", inline="loFill", group=g1, display=display.none)
loFilClr = input.color(color.new(clr1, 97), "", inline="loFill", group=g1, display=display.none)

// Smooth Average of Anchors
shoMA = input.bool(false, "Smooth Average    ", inline="smooth", group=g1, display=display.none)
maTyp = input.string("SMMA (RMA)", "", ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA", "Linear Regression"], inline="smooth", group=g1, display=display.none)
maLen = input.int(3, "", 1, inline="smooth", group=g1, display=display.none)

// Anchor Reset Settings
sessionLimited = input.bool(true, "Limit anchor session continuation to ", "Defines when a given anchor should be reset if its VWAP has not been broken, measured in sessions.", inline="reset", group=g1, display=display.none)
anchorMax = input.int(1, "", 1, inline="reset", group=g1, display=display.none)
mktHrsOnly = input.bool(false, "Limit anchor resets to Regular Trading Hours & New Sessions", "Prevents a given VWAP from resetting after hours, overnight, or during the premarket.", group=g1, display=display.none)

// High / Low Anchor Labels
hiLoLabels = input.bool(true, "Label: High & Low anchor", group=g1, display=display.none)
avgLabel = input.bool(true, "Label: Avg. of anchors", group=g1, display=display.none)

// 1 Day VWAP
shoVWAP = input.bool(true, "Day 1", "Line color and width of Day 1 VWAP.", inline="vwap", group=g2, display=display.none)
vwap1Clr = input.color(color.blue, "", inline="vwap", group=g2, display=display.none)
vWidth1 = input.int(2, "", 1, inline="vwap", group=g2, display=display.none)
label1 = input.bool(true, "Label", inline="vwap", group=g2, display=display.none)

// 2 Day VWAP
shoDay2 = input.bool(false, "Day 2", "Line color and width of Day 2 VWAP.", inline="vwap2", group=g2, display=display.none)
vwap2Clr = input.color(color.yellow, "", inline="vwap2", group=g2, display=display.none)
vWidth2 = input.int(2, "", 1, inline="vwap2", group=g2, display=display.none)
label2 = input.bool(true, "Label", inline="vwap2", group=g2, display=display.none)

// 3 Day VWAP
shoDay3 = input.bool(false, "Day 3", "Line color and width of Day 3 VWAP.", inline="vwap3", group=g2, display=display.none)
vwap3Clr = input.color(color.rgb(233, 30, 100), "", inline="vwap3", group=g2, display=display.none)
vWidth3 = input.int(2, "", 1, inline="vwap3", group=g2, display=display.none)
label3 = input.bool(true, "Label", inline="vwap3", group=g2, display=display.none)

// General VWAP Settings
const string cc1 = "Session", const string cc2 = "Anchor"
source1 = input.string(HLC3, "VWAP Source        ", [O,H,L,C,HL2, HLC3, OHLC4, HLCC4], inline = "vwapSource", group=g2, display=display.none)
clrMode = input.string(cc1, "Color Cycling         ", [cc1, cc2], "\"" + cc1 + "\" keeps colors consistent across sessions, where the D1 VWAP will always have it's specified color, D2 it's specified color, and D3 it's specified color.\n\n\"" + cc2 + "\" keeps colors consistent across anchors, where a given anchor will have the same color across sessions. Colors are cycled in this mode, so D1 VWAP will have a different color every day.", inline="vwapCycle", group=g2, display=display.none)

// Time Weighted Average
shoTWAP = input.bool(false, "", "Color and width of the TWAP.", inline="lr", group=g3, display=display.none)
twapTyp = input.string("Linear Regression", "", ["SMA", "WMA", "VWMA", "Linear Regression"], inline="lr", group=g3, display=display.none)
twapClr = input.color(color.orange, "", inline="lr", group=g3, display=display.none)
twapWid = input.int(2, "", 1, inline="lr", group=g3, display=display.none)
twapLbl = input.bool(true, "Label", inline="lr", group=g3, display=display.none)
twapDir = input.bool(false, "Directional colors              ", "When enabled, plots with negative slopes will inherit this opacity, where \"100\" is the full color value, and \"0\" is transparent.", inline="lr2", group=g3, display=display.none)
twapTrp = input.int(50, "", 0, 100, 1, inline="lr2", group=g3, display=display.none)
twapLen = input.int(1440, "Max Length  ", 2, inline="lr3", group=g3, display=display.none)
twapSes = input.string("Session", "", ["Session", "Perpetual"], inline="lr3", group=g3, display=display.none)
twapSrc = input.string(HLC3, "Source          ", [O,H,L,C,HL2, HLC3, OHLC4, HLCC4], inline="lr4", group=g3, display=display.none)

// Market Hours Settings
mktHrs = input.session("0930-1600", "Start / End Time", tooltip = "A 24 hour format, where 0930 is 9:30 AM, 1600 is 4:00 PM, etc.", inline="mkt", group=g4, display=display.none)
zone = input("America/New_York", "Time Zone          ", "Any IANA time zone ID. Ex: America/New_York\n\nYou can also use \"syminfo.timezone\", which inherits the time zone of the exchange of the chart.", inline="zone", group=g4, display=display.none)
var timezone = zone == "syminfo.timezone" ? syminfo.timezone : zone
const string minutesInDay = "1440", marketHours = not na(time(minutesInDay, mktHrs, timezone))

// ---- Signal Settings ----
const string SIG_CROSS = "Crossover", const string SIG_MEAN = "Mean Reversion", const string SIG_BOTH = "Both"
shoSignals = input.bool(true, "Enable Signals       ", "Show Buy/Sell signal markers on the chart.", inline="sigEn", group=g5, display=display.none)
sigMode = input.string(SIG_BOTH, "Signal Mode            ", [SIG_CROSS, SIG_MEAN, SIG_BOTH], "Crossover: signals when price crosses VWAP levels.\nMean Reversion: signals when price reverses from extremes.\nBoth: shows all signals.", inline="sigMode", group=g5, display=display.none)
sigBuyClr = input.color(color.lime, "Buy Color   ", inline="sigClr", group=g5, display=display.none)
sigSellClr = input.color(color.red, "Sell Color", inline="sigClr", group=g5, display=display.none)
sigMktHrs = input.bool(false, "Signals only during Market Hours", "When enabled, signals only fire during regular trading hours.", group=g5, display=display.none)
sigCooldown = input.int(3, "Min bars between signals  ", 1, 50, 1, "Minimum number of bars between consecutive signals to reduce noise.", group=g5, display=display.none)

// ---- Take Profit / Stop Loss Settings ----
shoTPSL = input.bool(true, "Show TP/SL Levels   ", "Display Take Profit and Stop Loss levels on chart.", inline="tpslEn", group=g6, display=display.none)
tpClr = input.color(color.new(color.lime, 30), "TP Color   ", inline="tpslClr", group=g6, display=display.none)
slClr = input.color(color.new(color.red, 30), "SL Color", inline="tpslClr", group=g6, display=display.none)
atrPeriod = input.int(14, "ATR Period              ", 1, 100, 1, "Period for ATR calculation used in TP/SL.", inline="atrP", group=g6, display=display.none)
atrTPMult = input.float(2.0, "ATR TP Multiplier    ", 0.5, 10.0, 0.1, "ATR multiplier for Take Profit when VWAP band target is not available.", inline="atrTP", group=g6, display=display.none)
atrSLMult = input.float(1.5, "ATR SL Multiplier    ", 0.5, 10.0, 0.1, "ATR multiplier for Stop Loss.", inline="atrSL", group=g6, display=display.none)
tpslStyle = input.string("Lines", "Display Style            ", ["Lines", "Labels", "Both"], inline="tpslSty", group=g6, display=display.none)

// ---- Statistics Panel Settings ----
shoStats = input.bool(true, "Show Statistics Panel", "Display detailed trading statistics table.", inline="statEn", group=g7, display=display.none)
statPos = input.string("Top Right", "Position                  ", ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], inline="statPos", group=g7, display=display.none)
statSize = input.string("small", "Text Size                ", ["tiny", "small", "normal"], inline="statSz", group=g7, display=display.none)
statBgClr = input.color(color.new(color.black, 80), "Background  ", inline="statBg", group=g7, display=display.none)
statTxtClr = input.color(color.white, "Text Color", inline="statBg", group=g7, display=display.none)
// }


// ------------------------------------------------------ CORE ------------------------------------------------------ {

// Put colors into an array
var colors = array.from(hiAnClr, loAnClr, midClr, qrtClr, hiEthClr, loEthClr, hiFilClr, loFilClr, vwap1Clr, vwap2Clr, vwap3Clr)
var vwapClrs = array.from(vwap1Clr, vwap2Clr, vwap3Clr)

// Initialize Labels
var showLbls = array.from(shoVWAP and label1, shoDay2 and label2, shoDay3 and label3, shoHiA and hiLoLabels, shoLoA and hiLoLabels, shoMid and avgLabel, shoTWAP and twapLbl)
var labels = array.new_label(showLbls.size())
if barstate.isfirst and showLbls.includes(true)
    for [i, show] in showLbls
        if show
            Text = "← " + (i < 3 ? "Day " + str.tostring(i + 1) : i < 4 ? "High Anchor" : i < 5 ? "Low Anchor" : i < 6 ? "Avg. of Anchors" : "TWAP")
            labels.set(i, label.new(time, open, Text, xloc.bar_time, yloc.price, none, label.style_label_left, chart.fg_color, size.normal, text.align_left))

// Define and count new sessions
newSession = timeframe.isdwm ? false : session.isfirstbar
var sessionCount = 0

// Set core variables
o = open, h = high, l = low, c = close, index = bar_index

// Define candle patterns and parts
candleBody = math.abs( c - o )
rising = c > o
falling = o > c
upWick = rising ? h - c : h - o
dnWick = falling ? c - l : o - l
doji = (upWick >= candleBody or dnWick >= candleBody) and (h != o and h != c and l != o and l != c)

// Anchor variables
var hi = h, var lo = l, var anchoredHi = h, var anchoredLo = l, var hrH = h, var hrL = l, var lrH = h, var lrL = l
var resetHiAnchor = false, var resetLoAnchor = false, var bullish = false, var bearish = false
var hiSessionCount = 0, var loSessionCount = 0

// Logic for what qualifies as "breaking" the previous anchors
breakingHigher = rising  and (c > hi or (c[1] > anchoredHi and c > h[1] and o > anchoredHi and not doji))
breakingLower  = falling and (c < lo or (c[1] < anchoredLo and c < l[1] and o < anchoredLo and not doji))

// Logic for when to reset anchors
if newSession and sessionLimited
    hiSessionCount += 1, loSessionCount += 1
    if hiSessionCount == anchorMax
        hiSessionCount := 0
        hi := h, hrH := h, hrL := l
        resetHiAnchor := true
        bullish := true
    if loSessionCount == anchorMax
        loSessionCount := 0
        lo := l, lrH := h, lrL := l
        resetLoAnchor := true
        bearish := true
else if breakingHigher and (not mktHrsOnly or (marketHours and marketHours))
    hiSessionCount := 0
    hi := h, hrH := h, hrL := l
    resetHiAnchor := true
    bullish := true
else if breakingLower and (not mktHrsOnly or (marketHours and marketHours))
    loSessionCount := 0
    lo := l, lrH := h, lrL := l
    resetLoAnchor := true
    bearish := true
else
    resetHiAnchor := false
    resetLoAnchor := false

// Function to get a price
price(s) => util.source(s, o, h, l, c)

// Set the Anchored VWAPs and their average
anchoredHi := ta.vwap(price(hiAvg), resetHiAnchor)
anchoredLo := ta.vwap(price(loAvg), resetLoAnchor)
anchoredMean = util.lerp(anchoredLo, anchoredHi, 0.5)

maSeries(string avgType, float price, series int length) =>
    switch avgType
        "SMA" => ta.sma(price, length)
        "WMA" => ta.wma(price, length)
        "VWMA" => ta.vwma(price, length)
        "Linear Regression" => ta.linreg(price, length, 0)

maSimple(string avgType, float price, simple int length) =>
    switch avgType
        "EMA" => ta.ema(price, length)
        "SMMA (RMA)" => ta.rma(price, length)

// Smooth the average according to the traders settings
if shoMA
    Simple = maTyp == "EMA" or maTyp == "SMMA (RMA)"
    anchoredMean := Simple
     ? maSimple(maTyp, anchoredMean, maLen)
     : maSeries(maTyp, anchoredMean, maLen)

// Set the interim values
avg12 = util.lerp(anchoredLo, anchoredMean, 0.25)
avg25 = util.lerp(anchoredLo, anchoredMean, 0.5)
avg37 = util.lerp(anchoredLo, anchoredMean, 0.75)
avg62 = util.lerp(anchoredMean, anchoredHi, 0.25)
avg75 = util.lerp(anchoredMean, anchoredHi, 0.5)
avg87 = util.lerp(anchoredMean, anchoredHi, 0.75)

// Initialize array to track daily VWAPs (up to 3 days)
var vwap = array.new_float(9, 0)

// Reset daily VWAP values
if newSession
    sessionCount += 1
    for i = 0 to 2
        vwap.unshift(0), vwap.pop()

// Set VWAP values
// https://www.tradingview.com/support/solutions/43000502018-volume-weighted-average-price-vwap/
vwap.set(1, vwap.get(1) + volume * price(source1))
vwap.set(2, vwap.get(2) + volume)
for i = 0 to 2
    prc = 0., vol = 0.
    for j = 0 to i
        prc += vwap.get(j * 3 + 1)
        vol += vwap.get(j * 3 + 2)
    vwap.set(i * 3, prc / vol)

// Set TWAP length
var twapLength = 1
if twapSes == "Session" and newSession
    twapLength := 1
else if twapLength < twapLen and bar_index != 0
    twapLength += 1

// Set TWAP value
twap = maSeries(twapTyp, price(twapSrc), twapLength)
if twapLength == 1
    twap := price(twapSrc)

// Function defining abnormal candle move continuation
moveCont(d) =>
    switch d
        "up" => anchoredHi >= anchoredHi[1] or hlcc4 > avg87
        "dn" => anchoredLo <= anchoredLo[1] or hlcc4 < avg12

// Function defining candle consolidation relative to the previous anchor
consolidating(d, resetHi, resetLo) => doji or (o <= resetHi and c <= resetHi and o >= resetLo and c >= resetLo)

// Set the plot and fill colors
var clr = array.new_color(colors.size())
for i = 0 to colors.size() - 1
    _c_ = colors.get(i)
    ifTrue = switch i
        0 => bullish and (resetHiAnchor or moveCont("up") or consolidating("up", hrH, hrL))
        1 => bearish and (resetLoAnchor or moveCont("dn") or consolidating("dn", lrH, lrL))
        => false
    clr.set(i, newSession ? none : ifTrue ? util.fade(_c_, 0.25) : _c_)

// Toggle the colors reset to be false if it has been reset back to the user specified color
bullish := clr.get(0) == hiAnClr ? false : bullish
bearish := clr.get(1) == loAnClr ? false : bearish
// }


// --------------------------------------------------- SIGNALS ------------------------------------------------------ {

// ATR for TP/SL calculations
atrValue = ta.atr(atrPeriod)

// Track bars since last signal for cooldown
var int barsSinceSignal = 999

// Signal conditions - check market hours filter
mktFilter = not sigMktHrs or marketHours
cooldownOk = barsSinceSignal >= sigCooldown

// --- Crossover Signals ---
// Buy: price crosses above anchored mean (average of high/low VWAP)
// Sell: price crosses below anchored mean
crossBuyRaw = ta.crossover(c, anchoredMean) and mktFilter
crossSellRaw = ta.crossunder(c, anchoredMean) and mktFilter

// --- Mean Reversion Signals ---
// Buy: price was at or below low anchor zone, then closes back above avg12 (reversal from low)
// Sell: price was at or above high anchor zone, then closes back below avg87 (reversal from high)
meanRevBuyRaw = c[1] <= anchoredLo and c > avg12 and rising and mktFilter
meanRevSellRaw = c[1] >= anchoredHi and c < avg87 and falling and mktFilter

// Combine signals based on mode
crossBuy = (sigMode == SIG_CROSS or sigMode == SIG_BOTH) and crossBuyRaw and cooldownOk
crossSell = (sigMode == SIG_CROSS or sigMode == SIG_BOTH) and crossSellRaw and cooldownOk
meanBuy = (sigMode == SIG_MEAN or sigMode == SIG_BOTH) and meanRevBuyRaw and cooldownOk
meanSell = (sigMode == SIG_MEAN or sigMode == SIG_BOTH) and meanRevSellRaw and cooldownOk

// Final combined signals (avoid duplicate on same bar)
buySignal = shoSignals and (crossBuy or meanBuy)
sellSignal = shoSignals and (crossSell or meanSell) and not buySignal

// Update cooldown counter
barsSinceSignal := buySignal or sellSignal ? 0 : barsSinceSignal + 1

// Determine signal type for labeling
isCrossBuy = crossBuy and not meanBuy
isMeanBuy = meanBuy and not crossBuy
isCrossSell = crossSell and not meanSell
isMeanSell = meanSell and not crossSell

// --- Hybrid TP/SL Calculation ---
// For Buy signals: TP1 = next VWAP band up (avg75 or anchoredHi), TP2 = ATR-based; SL = ATR-based or low anchor
// For Sell signals: TP1 = next VWAP band down (avg25 or anchoredLo), TP2 = ATR-based; SL = ATR-based or high anchor

var float activeTP = na
var float activeSL = na
var float activeEntry = na
var int activeDir = 0  // 1 = long, -1 = short, 0 = flat

// Calculate TP/SL on new signals
if buySignal
    activeEntry := c
    activeDir := 1
    // TP: Use next VWAP band above entry, fallback to ATR
    vwapTP = c < avg62 ? avg62 : c < avg75 ? avg75 : c < avg87 ? avg87 : c < anchoredHi ? anchoredHi : na
    atrTP = c + atrValue * atrTPMult
    activeTP := not na(vwapTP) ? math.max(vwapTP, c + atrValue * 0.5) : atrTP
    // SL: ATR-based with VWAP band floor
    atrSL = c - atrValue * atrSLMult
    vwapSL = c > avg25 ? avg25 : c > avg12 ? avg12 : c > anchoredLo ? anchoredLo : na
    activeSL := not na(vwapSL) ? math.min(math.max(vwapSL, atrSL), c - atrValue * 0.3) : atrSL

if sellSignal
    activeEntry := c
    activeDir := -1
    // TP: Use next VWAP band below entry, fallback to ATR
    vwapTP = c > avg37 ? avg37 : c > avg25 ? avg25 : c > avg12 ? avg12 : c > anchoredLo ? anchoredLo : na
    atrTP = c - atrValue * atrTPMult
    activeTP := not na(vwapTP) ? math.min(vwapTP, c - atrValue * 0.5) : atrTP
    // SL: ATR-based with VWAP band ceiling
    atrSL = c + atrValue * atrSLMult
    vwapSL = c < avg75 ? avg75 : c < avg87 ? avg87 : c < anchoredHi ? anchoredHi : na
    activeSL := not na(vwapSL) ? math.max(math.min(vwapSL, atrSL), c + atrValue * 0.3) : atrSL

// Check if TP or SL was hit
tpHit = activeDir == 1 ? (h >= activeTP) : activeDir == -1 ? (l <= activeTP) : false
slHit = activeDir == 1 ? (l <= activeSL) : activeDir == -1 ? (h >= activeSL) : false

// --- Statistics Tracking ---
var int totalTrades = 0
var int totalWins = 0
var int totalLosses = 0
var int longTrades = 0
var int longWins = 0
var int shortTrades = 0
var int shortWins = 0
var float totalProfit = 0.0
var float totalLoss = 0.0
var float grossProfit = 0.0
var float grossLoss = 0.0
var float maxDrawdown = 0.0
var float peakEquity = 0.0
var float currentEquity = 0.0
var int consecWins = 0
var int consecLosses = 0
var int maxConsecWins = 0
var int maxConsecLosses = 0
var float sumReturns = 0.0
var float sumReturnsSq = 0.0

// Close trade on TP/SL hit or opposite signal
tradeClose = (activeDir != 0) and (tpHit or slHit or (activeDir == 1 and sellSignal) or (activeDir == -1 and buySignal))

if tradeClose and activeDir != 0
    float pnl = 0.0
    if activeDir == 1
        pnl := tpHit ? (activeTP - activeEntry) : slHit ? (activeSL - activeEntry) : (c - activeEntry)
    else
        pnl := tpHit ? (activeEntry - activeTP) : slHit ? (activeEntry - activeSL) : (activeEntry - c)

    pctReturn = activeEntry != 0 ? pnl / activeEntry * 100 : 0.0
    totalTrades += 1

    if activeDir == 1
        longTrades += 1
    else
        shortTrades += 1

    if pnl > 0
        totalWins += 1
        grossProfit += pnl
        consecWins += 1
        consecLosses := 0
        maxConsecWins := math.max(maxConsecWins, consecWins)
        if activeDir == 1
            longWins += 1
        else
            shortWins += 1
    else if pnl < 0
        totalLosses += 1
        grossLoss += math.abs(pnl)
        consecLosses += 1
        consecWins := 0
        maxConsecLosses := math.max(maxConsecLosses, consecLosses)

    currentEquity += pnl
    peakEquity := math.max(peakEquity, currentEquity)
    drawdown = peakEquity - currentEquity
    maxDrawdown := math.max(maxDrawdown, drawdown)

    sumReturns += pctReturn
    sumReturnsSq += pctReturn * pctReturn

    // Reset position if TP/SL hit (not if closed by opposite signal which opens new position)
    if tpHit or slHit
        if not buySignal and not sellSignal
            activeDir := 0
            activeTP := na
            activeSL := na
            activeEntry := na
// }


// ----------------------------------------------------- PLOTS ------------------------------------------------------ {

// Plot helpers
displayPlot(ifTrue) => ifTrue ? display.pane : display.none
displayFill(ifTrue) => ifTrue ? display.all : display.none
vwapDay(day) => vwap.get((day + 1) * 3 - 3)
var showVWAPs = array.from(shoVWAP, shoDay2, shoDay3)
vwapClr(day) =>
    i = day - (clrMode == cc2 ? sessionCount % 3 : 0)
    newSession or not showVWAPs.get(day) ? na : vwapClrs.get(i < 0 ? i + 3 : i)

// Plot VWAP
plot(vwapDay(0), "Day 1 VWAP", vwapClr(0), vWidth1, plot.style_linebr, editable = false, display = displayPlot(shoVWAP))
plot(vwapDay(1), "Day 2 VWAP", vwapClr(1), vWidth2, plot.style_linebr, editable = false, display = displayPlot(shoDay2))
plot(vwapDay(2), "Day 3 VWAP", vwapClr(2), vWidth3, plot.style_linebr, editable = false, display = displayPlot(shoDay3))

// Plot TWAP
twapColor = session.isfirstbar and not timeframe.isdwm ? na : twap > twap[1] or not twapDir ? twapClr : util.fade(twapClr, twapTrp / 100)
plot(twap, "TWAP", twapColor, 2, plot.style_linebr, false, 0, 0, false, false, display = shoTWAP ? display.pane : display.none)

// Plot the top, bottom, and average anchor values
top = plot(anchoredHi, "High Anchor", clr.get(0), hiWidth, plot.style_linebr, editable = false, display = displayPlot(shoHiA))
bot = plot(anchoredLo, "Low Anchor",  clr.get(1), loWidth, plot.style_linebr, editable = false, display = displayPlot(shoLoA))
mid = plot(anchoredMean, "Average of Anchors", clr.get(2), mWidth, plot.style_linebr, editable = false, display = displayPlot(shoMid))

// Plot 1/4 values (half way between average and anchor)
var showQuarters = displayPlot(shoQrt)
t25 = plot(avg75, "Top 25% Line",    clr.get(3), qWidth, plot.style_linebr, editable = false, display = showQuarters)
b25 = plot(avg25, "Bottom 25% Line", clr.get(3), qWidth, plot.style_linebr, editable = false, display = showQuarters)

// Plot 1/8 lines
var showHideTopLine = displayPlot(shoHiFil)
var showHideBotLine = displayPlot(shoLoFil)
t12  = plot(avg87, "Top 12.5% Line",    clr.get(4), 1, plot.style_linebr, editable = false, display = showHideTopLine)
t252 = plot(avg75, "Top 25% Line",      clr.get(4), 1, plot.style_linebr, editable = false, display = showHideTopLine)
t37  = plot(avg62, "Top 37.5% Line",    clr.get(4), 1, plot.style_linebr, editable = false, display = showHideTopLine)
b37  = plot(avg37, "Bottom 37.5% Line", clr.get(5), 1, plot.style_linebr, editable = false, display = showHideBotLine)
b252 = plot(avg25, "Bottom 25% Line",   clr.get(5), 1, plot.style_linebr, editable = false, display = showHideBotLine)
b12  = plot(avg12, "Bottom 12.5% Line", clr.get(5), 1, plot.style_linebr, editable = false, display = showHideBotLine)

// Plot 1/8 fills
var showHideTopFill = displayFill(shoHiFil)
var showHideBotFill = displayFill(shoLoFil)
fill(top, t12, clr.get(6), "Top 12.5% Fill",    false, display = showHideTopFill)
fill(top, t25, clr.get(6), "Top 25% Fill",      false, display = showHideTopFill)
fill(top, t37, clr.get(6), "Top 37.5% Fill",    false, display = showHideTopFill)
fill(bot, b37, clr.get(7), "Bottom 37.5% Fill", false, display = showHideBotFill)
fill(bot, b25, clr.get(7), "Bottom 25% Fill",   false, display = showHideBotFill)
fill(bot, b12, clr.get(7), "Bottom 12.5% Fill", false, display = showHideBotFill)

// Update VWAP Labels
label_y = array.from(vwap.get(0), vwap.get(3), vwap.get(6), anchoredHi, anchoredLo, anchoredMean, twap)
label_c = array.from(vwapClr(0), vwapClr(1), vwapClr(2), clr.get(0), clr.get(1), clr.get(2), twapColor)
for [i, lbl] in labels
    if not na(lbl)
        y = label_y.get(i)
        lbl.set_xy(time, y)
        lbl.set_textcolor(label_c.get(i))
        lbl.set_tooltip(str.substring(" " + lbl.get_text(), 2) + " @ " + str.tostring(math.round_to_mintick(y)) + " ")

// --- Signal Plots (2 plotshape calls: 1 buy + 1 sell) ---
// Buy: triangle for crossover, diamond for mean reversion; both signals get larger triangle
buyShape = crossBuy and meanBuy ? shape.arrowup : meanBuy ? shape.diamond : shape.triangleup
buySize = crossBuy and meanBuy ? size.normal : size.small
plotshape(buySignal, "Buy Signal", buyShape, location.belowbar, sigBuyClr, size=buySize, display=displayPlot(shoSignals))

// Sell: triangle for crossover, diamond for mean reversion; both signals get larger triangle
sellShape = crossSell and meanSell ? shape.arrowdown : meanSell ? shape.diamond : shape.triangledown
sellSize = crossSell and meanSell ? size.normal : size.small
plotshape(sellSignal, "Sell Signal", sellShape, location.abovebar, sigSellClr, size=sellSize, display=displayPlot(shoSignals))

// --- TP/SL Level Drawing (using lines instead of plot to save plot calls) ---
var line tpLine = na, var line slLine = na, var line entryLine = na
var label tpLbl = na, var label slLbl = na

if shoTPSL
    if buySignal or sellSignal
        // Clean up previous lines/labels
        if not na(tpLine)
            line.delete(tpLine), line.delete(slLine), line.delete(entryLine)
            label.delete(tpLbl), label.delete(slLbl)
        // Draw new TP/SL/Entry lines
        entryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, color=color.new(color.gray, 50), style=line.style_dashed, width=1)
        tpLine := line.new(bar_index, activeTP, bar_index + 1, activeTP, color=tpClr, style=line.style_dashed, width=1)
        slLine := line.new(bar_index, activeSL, bar_index + 1, activeSL, color=slClr, style=line.style_dashed, width=1)
        tpLbl := label.new(bar_index + 1, activeTP, "TP " + str.tostring(math.round_to_mintick(activeTP)), xloc.bar_index, yloc.price, tpClr, label.style_label_left, color.white, size.tiny)
        slLbl := label.new(bar_index + 1, activeSL, "SL " + str.tostring(math.round_to_mintick(activeSL)), xloc.bar_index, yloc.price, slClr, label.style_label_left, color.white, size.tiny)
    else if activeDir != 0 and not na(tpLine)
        // Extend lines to current bar
        line.set_x2(tpLine, bar_index), line.set_x2(slLine, bar_index), line.set_x2(entryLine, bar_index)
        label.set_x(tpLbl, bar_index + 1), label.set_x(slLbl, bar_index + 1)

    // TP/SL hit markers (using labels instead of plotshape)
    if tpHit and activeDir != 0
        label.new(bar_index, activeTP, "TP", xloc.bar_index, yloc.price, tpClr, label.style_xcross, color.white, size.tiny)
    if slHit and activeDir != 0
        label.new(bar_index, activeSL, "SL", xloc.bar_index, yloc.price, slClr, label.style_xcross, color.white, size.tiny)

    // Clear lines when position is closed
    if activeDir == 0 and not na(tpLine)
        line.delete(tpLine), line.delete(slLine), line.delete(entryLine)
        label.delete(tpLbl), label.delete(slLbl)
        tpLine := na, slLine := na, entryLine := na
        tpLbl := na, slLbl := na
// }


// --------------------------------------------------- STATISTICS --------------------------------------------------- {

// Table position and text size (global scope for var table init)
statTblPos = switch statPos
    "Top Left" => position.top_left
    "Top Right" => position.top_right
    "Bottom Left" => position.bottom_left
    => position.bottom_right

statTxtSize = switch statSize
    "tiny" => size.tiny
    "small" => size.small
    => size.normal

// Create statistics table at global scope
var table statTbl = shoStats ? table.new(statTblPos, 3, 17, statBgClr, color.new(color.gray, 80), 1, color.new(color.gray, 80), 1) : na

// Row helper at global scope (no type annotations needed)
statRow(tblRef, row, lbl, val, valClr, txtClr, txtSz) =>
    table.cell(tblRef, 0, row, lbl, text_color=txtClr, text_size=txtSz, text_halign=text.align_left)
    table.cell(tblRef, 1, row, val, text_color=valClr, text_size=txtSz, text_halign=text.align_right)
    table.merge_cells(tblRef, 1, row, 2, row)

if shoStats and barstate.islast and not na(statTbl)
    // Calculate derived stats
    winRate = totalTrades > 0 ? totalWins / totalTrades * 100 : 0.0
    avgWin = totalWins > 0 ? grossProfit / totalWins : 0.0
    avgLoss = totalLosses > 0 ? grossLoss / totalLosses : 0.0
    profitFactor = grossLoss > 0 ? grossProfit / grossLoss : grossProfit > 0 ? 999.99 : 0.0
    netProfit = grossProfit - grossLoss
    longWinRate = longTrades > 0 ? longWins / longTrades * 100 : 0.0
    shortWinRate = shortTrades > 0 ? shortWins / shortTrades * 100 : 0.0
    shortLosses = shortTrades - shortWins
    longLosses = longTrades - longWins

    // Sharpe Ratio approximation
    meanReturn = totalTrades > 0 ? sumReturns / totalTrades : 0.0
    variance = totalTrades > 1 ? (sumReturnsSq - sumReturns * sumReturns / totalTrades) / (totalTrades - 1) : 0.0
    stdDev = math.sqrt(math.max(variance, 0))
    sharpeRatio = stdDev > 0 ? meanReturn / stdDev : 0.0

    // Header
    table.cell(statTbl, 0, 0, "AVWAP Trading Stats", text_color=statTxtClr, text_size=statTxtSize, bgcolor=color.new(color.blue, 70), text_halign=text.align_center)
    table.merge_cells(statTbl, 0, 0, 2, 0)

    // Column headers
    table.cell(statTbl, 0, 1, "Metric", text_color=statTxtClr, text_size=statTxtSize, text_halign=text.align_left)
    table.cell(statTbl, 1, 1, "Value", text_color=statTxtClr, text_size=statTxtSize, text_halign=text.align_right)
    table.cell(statTbl, 2, 1, "", text_color=statTxtClr, text_size=statTxtSize)

    // Overall stats
    statRow(statTbl, 2, "Total Trades", str.tostring(totalTrades), statTxtClr, statTxtClr, statTxtSize)
    statRow(statTbl, 3, "Win / Loss", str.tostring(totalWins) + " / " + str.tostring(totalLosses), statTxtClr, statTxtClr, statTxtSize)
    statRow(statTbl, 4, "Win Rate", str.tostring(winRate, "#.1") + "%", winRate >= 50 ? color.lime : color.orange, statTxtClr, statTxtSize)
    statRow(statTbl, 5, "Profit Factor", str.tostring(profitFactor, "#.##"), profitFactor >= 1 ? color.lime : color.red, statTxtClr, statTxtSize)
    statRow(statTbl, 6, "Net Profit", str.tostring(netProfit, "#.##"), netProfit >= 0 ? color.lime : color.red, statTxtClr, statTxtSize)

    // Averages
    statRow(statTbl, 7, "Avg Win", str.tostring(avgWin, "#.##"), color.lime, statTxtClr, statTxtSize)
    statRow(statTbl, 8, "Avg Loss", str.tostring(avgLoss, "#.##"), color.red, statTxtClr, statTxtSize)
    rr = avgLoss != 0 ? avgWin / avgLoss : 0.0
    statRow(statTbl, 9, "Avg RR Ratio", str.tostring(rr, "#.##"), rr >= 1 ? color.lime : color.orange, statTxtClr, statTxtSize)

    // Risk metrics
    statRow(statTbl, 10, "Max Drawdown", str.tostring(maxDrawdown, "#.##"), maxDrawdown > 0 ? color.red : statTxtClr, statTxtClr, statTxtSize)
    statRow(statTbl, 11, "Sharpe Ratio", str.tostring(sharpeRatio, "#.##"), sharpeRatio >= 1 ? color.lime : sharpeRatio >= 0 ? color.orange : color.red, statTxtClr, statTxtSize)

    // Streaks
    statRow(statTbl, 12, "Max Consec. Wins", str.tostring(maxConsecWins), color.lime, statTxtClr, statTxtSize)
    statRow(statTbl, 13, "Max Consec. Losses", str.tostring(maxConsecLosses), color.red, statTxtClr, statTxtSize)

    // Long/Short breakdown
    table.cell(statTbl, 0, 14, "Long / Short", text_color=statTxtClr, text_size=statTxtSize, bgcolor=color.new(color.blue, 70), text_halign=text.align_center)
    table.merge_cells(statTbl, 0, 14, 2, 14)
    statRow(statTbl, 15, "Long (W/L)", str.tostring(longWins) + " / " + str.tostring(longLosses) + "  (" + str.tostring(longWinRate, "#.1") + "%)", color.lime, statTxtClr, statTxtSize)
    statRow(statTbl, 16, "Short (W/L)", str.tostring(shortWins) + " / " + str.tostring(shortLosses) + "  (" + str.tostring(shortWinRate, "#.1") + "%)", color.red, statTxtClr, statTxtSize)
// }


// ---------------------------------------------------- ALERTS ------------------------------------------------------ {

// Crossover alerts
alertcondition(crossBuyRaw, "AVWAP Crossover Buy", "AVWAP: Price crossed above average of anchors (Bullish Crossover)")
alertcondition(crossSellRaw, "AVWAP Crossover Sell", "AVWAP: Price crossed below average of anchors (Bearish Crossover)")

// Mean reversion alerts
alertcondition(meanRevBuyRaw, "AVWAP Mean Rev Buy", "AVWAP: Price reversed from low anchor zone (Bullish Mean Reversion)")
alertcondition(meanRevSellRaw, "AVWAP Mean Rev Sell", "AVWAP: Price reversed from high anchor zone (Bearish Mean Reversion)")

// Combined signal alerts
alertcondition(buySignal, "AVWAP Buy Signal", "AVWAP: Buy Signal triggered")
alertcondition(sellSignal, "AVWAP Sell Signal", "AVWAP: Sell Signal triggered")

// TP/SL alerts
alertcondition(tpHit and activeDir == 1, "AVWAP Long TP Hit", "AVWAP: Long Take Profit target reached")
alertcondition(tpHit and activeDir == -1, "AVWAP Short TP Hit", "AVWAP: Short Take Profit target reached")
alertcondition(slHit and activeDir == 1, "AVWAP Long SL Hit", "AVWAP: Long Stop Loss triggered")
alertcondition(slHit and activeDir == -1, "AVWAP Short SL Hit", "AVWAP: Short Stop Loss triggered")

// Anchor reset alerts
alertcondition(resetHiAnchor, "AVWAP High Anchor Reset", "AVWAP: High anchor has been reset (bullish breakout)")
alertcondition(resetLoAnchor, "AVWAP Low Anchor Reset", "AVWAP: Low anchor has been reset (bearish breakout)")
// }
