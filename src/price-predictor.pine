//@version=6
indicator("SMC / ICT Forex [Smart Money]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================
// INPUTS
// ============================================================================

// — General Settings —
g_general         = "══════ General ══════"
swingLen          = input.int(5, "Swing Detection Length", minval=2, maxval=20, group=g_general)
maxStructures     = input.int(5, "Max Structure Lines", minval=1, maxval=20, group=g_general)
atrLen            = input.int(14, "ATR Length", minval=5, maxval=50, group=g_general)

// — Market Structure —
g_ms              = "══════ Market Structure ══════"
showBOS           = input.bool(true, "Show Break of Structure (BOS)", group=g_ms)
showCHoCH         = input.bool(true, "Show Change of Character (CHoCH)", group=g_ms)
showSwings        = input.bool(true, "Show Swing Points", group=g_ms)

// — Order Blocks —
g_ob              = "══════ Order Blocks ══════"
showOB            = input.bool(true, "Show Order Blocks", group=g_ob)
maxOB             = input.int(3, "Max Order Blocks Shown", minval=1, maxval=10, group=g_ob)
obMitigationType  = input.string("Wick", "OB Mitigation Type", options=["Wick", "Close"], group=g_ob)

// — Fair Value Gaps —
g_fvg             = "══════ Fair Value Gaps ══════"
showFVG           = input.bool(true, "Show Fair Value Gaps", group=g_fvg)
maxFVG            = input.int(3, "Max FVGs Shown", minval=1, maxval=10, group=g_fvg)
fvgFilterATR      = input.float(0.2, "Min FVG Size (ATR mult)", minval=0.05, maxval=1.0, step=0.05, group=g_fvg)

// — Liquidity —
g_liq             = "══════ Liquidity ══════"
showLiquidity     = input.bool(true, "Show Liquidity Levels", group=g_liq)
eqhEqlLen         = input.int(3, "Equal H/L Detection Bars", minval=2, maxval=10, group=g_liq)
eqhEqlTolerance   = input.float(0.1, "Equal H/L Tolerance (ATR mult)", minval=0.01, maxval=0.5, step=0.01, group=g_liq)
showSweeps        = input.bool(true, "Show Liquidity Sweeps", group=g_liq)

// — Kill Zones —
g_kz              = "══════ Kill Zones (UTC) ══════"
useKillZones      = input.bool(true, "Enable Kill Zone Filter", group=g_kz)
showKZBackground  = input.bool(true, "Show Kill Zone Background", group=g_kz)
kzAsianStart      = input.int(0, "Asian Session Start (UTC hour)", minval=0, maxval=23, group=g_kz)
kzAsianEnd        = input.int(4, "Asian Session End (UTC hour)", minval=0, maxval=23, group=g_kz)
kzLondonStart     = input.int(7, "London Session Start (UTC hour)", minval=0, maxval=23, group=g_kz)
kzLondonEnd       = input.int(10, "London Session End (UTC hour)", minval=0, maxval=23, group=g_kz)
kzNYStart         = input.int(12, "NY Session Start (UTC hour)", minval=0, maxval=23, group=g_kz)
kzNYEnd           = input.int(15, "NY Session End (UTC hour)", minval=0, maxval=23, group=g_kz)

// — Premium/Discount —
g_pd              = "══════ Premium / Discount ══════"
showPDZones       = input.bool(true, "Show Premium/Discount Zones", group=g_pd)
pdLookback        = input.int(50, "Range Lookback", minval=10, maxval=200, group=g_pd)

// — Signal Settings —
g_sig             = "══════ Signal Settings ══════"
minConfluence     = input.int(3, "Min Confluence for Signal", minval=1, maxval=6, group=g_sig)
showSignals       = input.bool(true, "Show Entry Signals", group=g_sig)
showTargets       = input.bool(true, "Show TP/SL Lines", group=g_sig)
rrRatio           = input.float(2.0, "Risk:Reward Ratio", minval=1.0, maxval=5.0, step=0.5, group=g_sig)

// — Visual Settings —
g_visual          = "══════ Visual ══════"
showDashboard     = input.bool(true, "Show Dashboard", group=g_visual)
bullColor         = input.color(color.new(#00E676, 0), "Bullish Color", group=g_visual)
bearColor         = input.color(color.new(#FF5252, 0), "Bearish Color", group=g_visual)
fvgBullColor      = input.color(color.new(#2196F3, 0), "FVG Bullish Color", group=g_visual)
fvgBearColor      = input.color(color.new(#FF9800, 0), "FVG Bearish Color", group=g_visual)
kzAsianColor      = input.color(color.new(#9C27B0, 92), "Asian KZ Color", group=g_visual)
kzLondonColor     = input.color(color.new(#2196F3, 92), "London KZ Color", group=g_visual)
kzNYColor         = input.color(color.new(#FF9800, 92), "NY KZ Color", group=g_visual)

// ============================================================================
// CORE CALCULATIONS
// ============================================================================
atrVal = ta.atr(atrLen)

// ============================================================================
// MODULE 1: MARKET STRUCTURE (BOS / CHoCH)
// ============================================================================

// — Swing High/Low Detection —
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low, swingLen, swingLen)

// Track structure
var float lastSwingHigh     = na
var float lastSwingLow      = na
var int   lastSwingHighBar  = na
var int   lastSwingLowBar   = na
var float prevSwingHigh     = na
var float prevSwingLow      = na
var int   trendDir          = 0   // 1 = bullish, -1 = bearish, 0 = undefined

// Structure break tracking
var bool  bosUp             = false
var bool  bosDn             = false
var bool  chochUp           = false
var bool  chochDn           = false

// Store swing points
if not na(swingHigh)
    prevSwingHigh    := lastSwingHigh
    lastSwingHigh    := swingHigh
    lastSwingHighBar := bar_index - swingLen

if not na(swingLow)
    prevSwingLow    := lastSwingLow
    lastSwingLow    := swingLow
    lastSwingLowBar := bar_index - swingLen

// Reset per bar
bosUp  := false
bosDn  := false
chochUp := false
chochDn := false

// BOS & CHoCH Detection
// Bullish BOS: price breaks above the last swing high in an uptrend
// Bearish BOS: price breaks below the last swing low in a downtrend
// CHoCH: structure break AGAINST current trend direction

if not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
    if trendDir == 1 or trendDir == 0
        bosUp   := true
    else
        chochUp := true
    trendDir := 1

if not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
    if trendDir == -1 or trendDir == 0
        bosDn   := true
    else
        chochDn := true
    trendDir := -1

// — Swing point labels —
if showSwings and not na(swingHigh)
    label.new(bar_index - swingLen, swingHigh, "HH", style=label.style_label_down, color=color.new(bearColor, 80), textcolor=bearColor, size=size.tiny)

if showSwings and not na(swingLow)
    label.new(bar_index - swingLen, swingLow, "LL", style=label.style_label_up, color=color.new(bullColor, 80), textcolor=bullColor, size=size.tiny)

// — BOS / CHoCH labels —
if showBOS and bosUp
    label.new(bar_index, high, "BOS ▲", style=label.style_label_down, color=color.new(bullColor, 70), textcolor=bullColor, size=size.tiny)

if showBOS and bosDn
    label.new(bar_index, low, "BOS ▼", style=label.style_label_up, color=color.new(bearColor, 70), textcolor=bearColor, size=size.tiny)

if showCHoCH and chochUp
    label.new(bar_index, high, "CHoCH ▲", style=label.style_label_down, color=color.new(#FFD700, 70), textcolor=color.new(#FFD700, 0), size=size.small)

if showCHoCH and chochDn
    label.new(bar_index, low, "CHoCH ▼", style=label.style_label_up, color=color.new(#FFD700, 70), textcolor=color.new(#FFD700, 0), size=size.small)

// ============================================================================
// MODULE 2: ORDER BLOCKS (Institutional)
// ============================================================================

// OB Arrays: [top, bottom, bar_index, direction(1=bull/-1=bear), mitigated(0/1)]
var array<float> obTops      = array.new_float(0)
var array<float> obBots      = array.new_float(0)
var array<int>   obBars      = array.new_int(0)
var array<int>   obDirs      = array.new_int(0)
var array<int>   obMitigated = array.new_int(0)

// Detect Order Blocks on structure breaks
// Bullish OB: last bearish candle before a bullish BOS/CHoCH
if (bosUp or chochUp) and showOB
    // Find the last bearish candle in the move
    for i = 1 to 10
        if close[i] < open[i]
            array.push(obTops, math.max(open[i], close[i]))
            array.push(obBots, math.min(open[i], close[i]))
            array.push(obBars, bar_index - i)
            array.push(obDirs, 1)
            array.push(obMitigated, 0)
            break

// Bearish OB: last bullish candle before a bearish BOS/CHoCH
if (bosDn or chochDn) and showOB
    for i = 1 to 10
        if close[i] > open[i]
            array.push(obTops, math.max(open[i], close[i]))
            array.push(obBots, math.min(open[i], close[i]))
            array.push(obBars, bar_index - i)
            array.push(obDirs, -1)
            array.push(obMitigated, 0)
            break

// Check OB mitigation
if array.size(obTops) > 0
    for i = array.size(obTops) - 1 to 0
        if array.get(obMitigated, i) == 0
            obTop = array.get(obTops, i)
            obBot = array.get(obBots, i)
            dir   = array.get(obDirs, i)
            if dir == 1  // Bullish OB — mitigated when price closes/wicks below
                mitigated = obMitigationType == "Close" ? close < obBot : low < obBot
                if mitigated
                    array.set(obMitigated, i, 1)
            else  // Bearish OB — mitigated when price closes/wicks above
                mitigated = obMitigationType == "Close" ? close > obTop : high > obTop
                if mitigated
                    array.set(obMitigated, i, 1)

// Count active (unmitigated) OBs
int activeBullOB = 0
int activeBearOB = 0
if array.size(obTops) > 0
    for i = 0 to array.size(obTops) - 1
        if array.get(obMitigated, i) == 0
            if array.get(obDirs, i) == 1
                activeBullOB += 1
            else
                activeBearOB += 1

// Trim old OBs (keep only recent ones)
while array.size(obTops) > maxOB * 4
    array.shift(obTops)
    array.shift(obBots)
    array.shift(obBars)
    array.shift(obDirs)
    array.shift(obMitigated)

// ============================================================================
// MODULE 3: FAIR VALUE GAPS
// ============================================================================

var array<float> fvgTops      = array.new_float(0)
var array<float> fvgBots      = array.new_float(0)
var array<int>   fvgBars      = array.new_int(0)
var array<int>   fvgDirs      = array.new_int(0)
var array<int>   fvgFilled    = array.new_int(0)

// Bullish FVG: gap between candle[2] high and candle[0] low (gap up)
bullFVGCond = low > high[2] and close[1] > open[1] and (low - high[2]) > atrVal * fvgFilterATR
if bullFVGCond and showFVG
    array.push(fvgTops, low)
    array.push(fvgBots, high[2])
    array.push(fvgBars, bar_index - 1)
    array.push(fvgDirs, 1)
    array.push(fvgFilled, 0)

// Bearish FVG: gap between candle[0] high and candle[2] low (gap down)
bearFVGCond = high < low[2] and close[1] < open[1] and (low[2] - high) > atrVal * fvgFilterATR
if bearFVGCond and showFVG
    array.push(fvgTops, low[2])
    array.push(fvgBots, high)
    array.push(fvgBars, bar_index - 1)
    array.push(fvgDirs, -1)
    array.push(fvgFilled, 0)

// Check FVG fill
if array.size(fvgTops) > 0
    for i = array.size(fvgTops) - 1 to 0
        if array.get(fvgFilled, i) == 0
            fTop = array.get(fvgTops, i)
            fBot = array.get(fvgBots, i)
            dir  = array.get(fvgDirs, i)
            if dir == 1 and low <= fBot
                array.set(fvgFilled, i, 1)
            if dir == -1 and high >= fTop
                array.set(fvgFilled, i, 1)

// Count active FVGs
int activeBullFVG = 0
int activeBearFVG = 0
if array.size(fvgTops) > 0
    for i = 0 to array.size(fvgTops) - 1
        if array.get(fvgFilled, i) == 0
            if array.get(fvgDirs, i) == 1
                activeBullFVG += 1
            else
                activeBearFVG += 1

// Trim old FVGs
while array.size(fvgTops) > maxFVG * 4
    array.shift(fvgTops)
    array.shift(fvgBots)
    array.shift(fvgBars)
    array.shift(fvgDirs)
    array.shift(fvgFilled)

// ============================================================================
// MODULE 4: LIQUIDITY (Equal Highs/Lows & Sweeps)
// ============================================================================

// Detect Equal Highs (EQH) — potential buy-side liquidity
var float lastEQH       = na
var int   lastEQHBar    = na
var bool  eqhSwept      = false
var float lastEQL       = na
var int   lastEQLBar    = na
var bool  eqlSwept      = false

// Equal highs: multiple swing highs at similar level
if not na(swingHigh) and not na(prevSwingHigh)
    if math.abs(swingHigh - prevSwingHigh) < atrVal * eqhEqlTolerance
        lastEQH    := math.max(swingHigh, prevSwingHigh)
        lastEQHBar := bar_index - swingLen
        eqhSwept   := false

// Equal lows: multiple swing lows at similar level
if not na(swingLow) and not na(prevSwingLow)
    if math.abs(swingLow - prevSwingLow) < atrVal * eqhEqlTolerance
        lastEQL    := math.min(swingLow, prevSwingLow)
        lastEQLBar := bar_index - swingLen
        eqlSwept   := false

// Detect sweeps
var bool sweepBSL = false  // Buy Side Liquidity swept
var bool sweepSSL = false  // Sell Side Liquidity swept
sweepBSL := false
sweepSSL := false

if not na(lastEQH) and not eqhSwept
    if high > lastEQH and close < lastEQH
        sweepBSL := true
        eqhSwept := true

if not na(lastEQL) and not eqlSwept
    if low < lastEQL and close > lastEQL
        sweepSSL := true
        eqlSwept := true

// Sweep labels
if showSweeps and sweepBSL
    label.new(bar_index, high, "BSL Sweep ✗", style=label.style_label_down, color=color.new(bearColor, 60), textcolor=bearColor, size=size.small)

if showSweeps and sweepSSL
    label.new(bar_index, low, "SSL Sweep ✗", style=label.style_label_up, color=color.new(bullColor, 60), textcolor=bullColor, size=size.small)

// ============================================================================
// MODULE 5: KILL ZONES (Session Timing)
// ============================================================================

// Get UTC hour
utcHour = hour(time, "UTC")

// Kill zone detection
inAsianKZ  = utcHour >= kzAsianStart and utcHour < kzAsianEnd
inLondonKZ = utcHour >= kzLondonStart and utcHour < kzLondonEnd
inNYKZ     = utcHour >= kzNYStart and utcHour < kzNYEnd
inActiveKZ = inLondonKZ or inNYKZ  // Only London & NY are active kill zones for entries
inAnyKZ    = inAsianKZ or inLondonKZ or inNYKZ

// Kill zone background
bgcolor(showKZBackground and inAsianKZ ? kzAsianColor : na, title="Asian KZ")
bgcolor(showKZBackground and inLondonKZ ? kzLondonColor : na, title="London KZ")
bgcolor(showKZBackground and inNYKZ ? kzNYColor : na, title="NY KZ")

// ============================================================================
// MODULE 6: PREMIUM / DISCOUNT ZONES
// ============================================================================

rangeHigh    = ta.highest(high, pdLookback)
rangeLow     = ta.lowest(low, pdLookback)
rangeSize    = rangeHigh - rangeLow
equilibrium  = rangeLow + rangeSize * 0.5

inPremium    = close > equilibrium
inDiscount   = close < equilibrium

// OTE zone (61.8% - 78.6% retracement)
// For bullish setup: OTE is in discount (61.8-78.6 from high)
oteBullTop   = rangeHigh - rangeSize * 0.618
oteBullBot   = rangeHigh - rangeSize * 0.786
// For bearish setup: OTE is in premium (61.8-78.6 from low)
oteBearTop   = rangeLow + rangeSize * 0.786
oteBearBot   = rangeLow + rangeSize * 0.618

inBullOTE    = close >= oteBullBot and close <= oteBullTop
inBearOTE    = close >= oteBearBot and close <= oteBearTop

// ============================================================================
// MODULE 7: CONFLUENCE-BASED SIGNAL ENGINE
// ============================================================================

// — Confluence factors for BULLISH setup —
int bullConfluence = 0

// 1. Bullish market structure (trend is up or CHoCH up)
bullStructure = trendDir == 1 or chochUp
if bullStructure
    bullConfluence += 1

// 2. Price at/near unmitigated bullish OB
bool atBullOB = false
if array.size(obTops) > 0
    for i = array.size(obTops) - 1 to math.max(0, array.size(obTops) - maxOB)
        if array.get(obMitigated, i) == 0 and array.get(obDirs, i) == 1
            if close <= array.get(obTops, i) and close >= array.get(obBots, i) - atrVal * 0.2
                atBullOB := true
                break
if atBullOB
    bullConfluence += 1

// 3. Unfilled bullish FVG nearby
bool nearBullFVG = false
if array.size(fvgTops) > 0
    for i = array.size(fvgTops) - 1 to math.max(0, array.size(fvgTops) - maxFVG)
        if array.get(fvgFilled, i) == 0 and array.get(fvgDirs, i) == 1
            fTop = array.get(fvgTops, i)
            fBot = array.get(fvgBots, i)
            if close <= fTop and close >= fBot - atrVal * 0.3
                nearBullFVG := true
                break
if nearBullFVG
    bullConfluence += 1

// 4. In discount zone / OTE
if inDiscount or inBullOTE
    bullConfluence += 1

// 5. SSL sweep (liquidity taken below, reversal expected)
if sweepSSL
    bullConfluence += 1

// 6. In active kill zone
if inActiveKZ or not useKillZones
    bullConfluence += 1

// — Confluence factors for BEARISH setup —
int bearConfluence = 0

// 1. Bearish market structure
bearStructure = trendDir == -1 or chochDn
if bearStructure
    bearConfluence += 1

// 2. Price at/near unmitigated bearish OB
bool atBearOB = false
if array.size(obTops) > 0
    for i = array.size(obTops) - 1 to math.max(0, array.size(obTops) - maxOB)
        if array.get(obMitigated, i) == 0 and array.get(obDirs, i) == -1
            if close >= array.get(obBots, i) and close <= array.get(obTops, i) + atrVal * 0.2
                atBearOB := true
                break
if atBearOB
    bearConfluence += 1

// 3. Unfilled bearish FVG nearby
bool nearBearFVG = false
if array.size(fvgTops) > 0
    for i = array.size(fvgTops) - 1 to math.max(0, array.size(fvgTops) - maxFVG)
        if array.get(fvgFilled, i) == 0 and array.get(fvgDirs, i) == -1
            fTop = array.get(fvgTops, i)
            fBot = array.get(fvgBots, i)
            if close >= fBot and close <= fTop + atrVal * 0.3
                nearBearFVG := true
                break
if nearBearFVG
    bearConfluence += 1

// 4. In premium zone / OTE
if inPremium or inBearOTE
    bearConfluence += 1

// 5. BSL sweep (liquidity taken above, reversal expected)
if sweepBSL
    bearConfluence += 1

// 6. In active kill zone
if inActiveKZ or not useKillZones
    bearConfluence += 1

// — Signal Generation —
bullSignal = bullConfluence >= minConfluence and showSignals
bearSignal = bearConfluence >= minConfluence and showSignals

// Prevent consecutive same-direction signals (cooldown)
var int lastSignalDir = 0
var int lastSignalBar = 0
signalCooldown = 5  // minimum bars between signals

newBullSignal = bullSignal and (lastSignalDir != 1 or (bar_index - lastSignalBar) > signalCooldown)
newBearSignal = bearSignal and (lastSignalDir != -1 or (bar_index - lastSignalBar) > signalCooldown)

// If both fire, pick stronger confluence
if newBullSignal and newBearSignal
    if bullConfluence >= bearConfluence
        newBearSignal := false
    else
        newBullSignal := false

if newBullSignal
    lastSignalDir := 1
    lastSignalBar := bar_index

if newBearSignal
    lastSignalDir := -1
    lastSignalBar := bar_index

// ============================================================================
// STATISTICS TRACKING
// ============================================================================

var int   totalSignals     = 0
var int   bullSignals      = 0
var int   bearSignals      = 0
var int   correctSignals   = 0
var int   incorrectSignals = 0
var int   pendingSignals   = 0
var float totalPnLPips     = 0.0

// Prediction tracking arrays
var array<float> predEntries     = array.new_float(0)
var array<int>   predExitBars    = array.new_int(0)
var array<int>   predDirs        = array.new_int(0)  // 1=bull, -1=bear
var array<float> predSLs         = array.new_float(0)
var array<float> predTPs         = array.new_float(0)

// SL/TP calculation
bullSL = na(lastSwingLow) ? close - atrVal * 1.5 : lastSwingLow - atrVal * 0.2
bearSL = na(lastSwingHigh) ? close + atrVal * 1.5 : lastSwingHigh + atrVal * 0.2
bullRisk = close - bullSL
bearRisk = bearSL - close
bullTP = close + bullRisk * rrRatio
bearTP = close - bearRisk * rrRatio

// Record signals
if newBullSignal
    totalSignals  += 1
    bullSignals   += 1
    pendingSignals += 1
    array.push(predEntries, close)
    array.push(predExitBars, bar_index + 20)
    array.push(predDirs, 1)
    array.push(predSLs, bullSL)
    array.push(predTPs, bullTP)

if newBearSignal
    totalSignals  += 1
    bearSignals   += 1
    pendingSignals += 1
    array.push(predEntries, close)
    array.push(predExitBars, bar_index + 20)
    array.push(predDirs, -1)
    array.push(predSLs, bearSL)
    array.push(predTPs, bearTP)

// Validate predictions (TP/SL hit or time expiry)
if array.size(predEntries) > 0
    int removeCount = 0
    for i = 0 to math.min(array.size(predEntries) - 1, 49)
        entry = array.get(predEntries, i)
        sl    = array.get(predSLs, i)
        tp    = array.get(predTPs, i)
        dir   = array.get(predDirs, i)
        exitB = array.get(predExitBars, i)

        bool resolved = false
        bool isWin    = false

        if dir == 1
            if high >= tp
                resolved := true
                isWin    := true
            else if low <= sl
                resolved := true
                isWin    := false
        else
            if low <= tp
                resolved := true
                isWin    := true
            else if high >= sl
                resolved := true
                isWin    := false

        // Time expiry
        if not resolved and bar_index >= exitB
            resolved := true
            priceDiff = dir == 1 ? close - entry : entry - close
            isWin    := priceDiff > 0

        if resolved
            pendingSignals -= 1
            if isWin
                correctSignals += 1
            else
                incorrectSignals += 1

            pipMultiplier = syminfo.mintick != 0 ? 1 / syminfo.mintick : 10000
            priceDiff     = dir == 1 ? close - entry : entry - close
            pnlPips       = math.abs(priceDiff) * pipMultiplier * (isWin ? 1 : -1)
            totalPnLPips += pnlPips
            removeCount  += 1

    if removeCount > 0
        for j = 1 to removeCount
            if array.size(predEntries) > 0
                array.shift(predEntries)
                array.shift(predExitBars)
                array.shift(predDirs)
                array.shift(predSLs)
                array.shift(predTPs)

winRate = (correctSignals + incorrectSignals) > 0 ? math.round(correctSignals / (correctSignals + incorrectSignals) * 100, 1) : 0.0

// ============================================================================
// VISUAL RENDERING — SIGNALS
// ============================================================================

// Signal markers
plotshape(newBullSignal, "Buy Signal", shape.triangleup, location.belowbar, bullColor, size=size.normal)
plotshape(newBearSignal, "Sell Signal", shape.triangledown, location.abovebar, bearColor, size=size.normal)

// Signal labels with confluence info
if newBullSignal
    txt = "BUY\nConf: " + str.tostring(bullConfluence) + "/6\n"
    txt += bullStructure ? "MS " : ""
    txt += atBullOB ? "OB " : ""
    txt += nearBullFVG ? "FVG " : ""
    txt += (inDiscount or inBullOTE) ? "OTE " : ""
    txt += sweepSSL ? "Sweep " : ""
    txt += (inActiveKZ or not useKillZones) ? "KZ" : ""
    label.new(bar_index, low - atrVal * 0.5, txt, style=label.style_label_up, color=color.new(bullColor, 70), textcolor=bullColor, size=size.small)

if newBearSignal
    txt = "SELL\nConf: " + str.tostring(bearConfluence) + "/6\n"
    txt += bearStructure ? "MS " : ""
    txt += atBearOB ? "OB " : ""
    txt += nearBearFVG ? "FVG " : ""
    txt += (inPremium or inBearOTE) ? "OTE " : ""
    txt += sweepBSL ? "Sweep " : ""
    txt += (inActiveKZ or not useKillZones) ? "KZ" : ""
    label.new(bar_index, high + atrVal * 0.5, txt, style=label.style_label_down, color=color.new(bearColor, 70), textcolor=bearColor, size=size.small)

// TP/SL lines
var line tpLine = na
var line slLine = na
var label tpLabel = na
var label slLabel = na

if not na(tpLine)
    line.delete(tpLine)
if not na(slLine)
    line.delete(slLine)
if not na(tpLabel)
    label.delete(tpLabel)
if not na(slLabel)
    label.delete(slLabel)

if showTargets and barstate.islast and lastSignalDir != 0 and (bar_index - lastSignalBar) < 30
    if lastSignalDir == 1
        tpLine := line.new(lastSignalBar, bullTP, bar_index + 5, bullTP, color=bullColor, style=line.style_dashed, width=1)
        slLine := line.new(lastSignalBar, bullSL, bar_index + 5, bullSL, color=bearColor, style=line.style_dashed, width=1)
        tpLabel := label.new(bar_index + 5, bullTP, "TP " + str.tostring(bullTP, "#.#####"), style=label.style_label_left, color=color.new(bullColor, 85), textcolor=bullColor, size=size.tiny)
        slLabel := label.new(bar_index + 5, bullSL, "SL " + str.tostring(bullSL, "#.#####"), style=label.style_label_left, color=color.new(bearColor, 85), textcolor=bearColor, size=size.tiny)
    else
        tpLine := line.new(lastSignalBar, bearTP, bar_index + 5, bearTP, color=bullColor, style=line.style_dashed, width=1)
        slLine := line.new(lastSignalBar, bearSL, bar_index + 5, bearSL, color=bearColor, style=line.style_dashed, width=1)
        tpLabel := label.new(bar_index + 5, bearTP, "TP " + str.tostring(bearTP, "#.#####"), style=label.style_label_left, color=color.new(bullColor, 85), textcolor=bullColor, size=size.tiny)
        slLabel := label.new(bar_index + 5, bearSL, "SL " + str.tostring(bearSL, "#.#####"), style=label.style_label_left, color=color.new(bearColor, 85), textcolor=bearColor, size=size.tiny)

// ============================================================================
// VISUAL RENDERING — OB/FVG BOXES
// ============================================================================

// Draw Order Blocks (only unmitigated, most recent)
var array<box> obBoxes = array.new_box(0)

// Clean old boxes
if array.size(obBoxes) > 0
    for i = array.size(obBoxes) - 1 to 0
        box.delete(array.get(obBoxes, i))
    array.clear(obBoxes)

if showOB and barstate.islast and array.size(obTops) > 0
    int drawnOB = 0
    for i = array.size(obTops) - 1 to 0
        if drawnOB >= maxOB
            break
        if array.get(obMitigated, i) == 0
            obT   = array.get(obTops, i)
            obB   = array.get(obBots, i)
            obBar = array.get(obBars, i)
            obD   = array.get(obDirs, i)
            clr   = obD == 1 ? bullColor : bearColor
            txt   = obD == 1 ? "Bull OB" : "Bear OB"
            b = box.new(obBar, obT, bar_index + 5, obB, border_color=color.new(clr, 40), bgcolor=color.new(clr, 88), text=txt, text_color=clr, text_size=size.tiny)
            array.push(obBoxes, b)
            drawnOB += 1

// Draw FVGs (only unfilled, most recent)
var array<box> fvgBoxes = array.new_box(0)

if array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        box.delete(array.get(fvgBoxes, i))
    array.clear(fvgBoxes)

if showFVG and barstate.islast and array.size(fvgTops) > 0
    int drawnFVG = 0
    for i = array.size(fvgTops) - 1 to 0
        if drawnFVG >= maxFVG
            break
        if array.get(fvgFilled, i) == 0
            fT    = array.get(fvgTops, i)
            fB    = array.get(fvgBots, i)
            fBar  = array.get(fvgBars, i)
            fD    = array.get(fvgDirs, i)
            clr   = fD == 1 ? fvgBullColor : fvgBearColor
            txt   = fD == 1 ? "Bull FVG" : "Bear FVG"
            b = box.new(fBar, fT, bar_index + 5, fB, border_color=color.new(clr, 40), bgcolor=color.new(clr, 90), text=txt, text_color=clr, text_size=size.tiny)
            array.push(fvgBoxes, b)
            drawnFVG += 1

// ============================================================================
// VISUAL RENDERING — LIQUIDITY LINES
// ============================================================================

var line eqhLine = na
var line eqlLine = na
var label eqhLabel_draw = na
var label eqlLabel_draw = na

if not na(eqhLine)
    line.delete(eqhLine)
if not na(eqlLine)
    line.delete(eqlLine)
if not na(eqhLabel_draw)
    label.delete(eqhLabel_draw)
if not na(eqlLabel_draw)
    label.delete(eqlLabel_draw)

if showLiquidity and barstate.islast
    if not na(lastEQH) and not eqhSwept
        eqhLine := line.new(lastEQHBar, lastEQH, bar_index + 10, lastEQH, color=color.new(bearColor, 50), style=line.style_dotted, width=2)
        eqhLabel_draw := label.new(bar_index + 10, lastEQH, "BSL $$$", style=label.style_label_left, color=color.new(bearColor, 85), textcolor=bearColor, size=size.tiny)

    if not na(lastEQL) and not eqlSwept
        eqlLine := line.new(lastEQLBar, lastEQL, bar_index + 10, lastEQL, color=color.new(bullColor, 50), style=line.style_dotted, width=2)
        eqlLabel_draw := label.new(bar_index + 10, lastEQL, "SSL $$$", style=label.style_label_left, color=color.new(bullColor, 85), textcolor=bullColor, size=size.tiny)

// ============================================================================
// VISUAL RENDERING — PREMIUM/DISCOUNT ZONES
// ============================================================================

var line eqLine = na
var box premBox = na
var box discBox = na

if not na(eqLine)
    line.delete(eqLine)
if not na(premBox)
    box.delete(premBox)
if not na(discBox)
    box.delete(discBox)

if showPDZones and barstate.islast
    eqLine := line.new(bar_index - pdLookback, equilibrium, bar_index + 5, equilibrium, color=color.gray, style=line.style_solid, width=1)
    premBox := box.new(bar_index - 10, rangeHigh, bar_index + 5, equilibrium, border_color=color.new(bearColor, 85), bgcolor=color.new(bearColor, 96), text="Premium", text_color=color.new(bearColor, 70), text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_top)
    discBox := box.new(bar_index - 10, equilibrium, bar_index + 5, rangeLow, border_color=color.new(bullColor, 85), bgcolor=color.new(bullColor, 96), text="Discount", text_color=color.new(bullColor, 70), text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_bottom)

// ============================================================================
// DASHBOARD
// ============================================================================

if showDashboard and barstate.islast
    var table dashboard = table.new(position.top_right, 2, 20, bgcolor=color.new(#1a1a2e, 10), border_color=color.new(#ffffff, 85), border_width=1, frame_color=color.new(#ffffff, 85), frame_width=1)

    headerBg   = color.new(#16213e, 0)
    headerTxt  = color.new(#e94560, 0)
    labelTxt   = color.new(#a2a2b5, 0)
    valueTxt   = color.new(#ffffff, 0)
    winClr     = winRate >= 50 ? color.new(#00E676, 0) : color.new(#FF5252, 0)
    bg1        = color.new(#1a1a2e, 0)
    bg2        = color.new(#0f3460, 0)

    // Row 0: Title
    table.cell(dashboard, 0, 0, "SMC / ICT", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 0, "FOREX", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 0, 1, 0)

    // Row 1: Trend
    trendTxt = trendDir == 1 ? "BULLISH" : trendDir == -1 ? "BEARISH" : "NEUTRAL"
    trendClr = trendDir == 1 ? bullColor : trendDir == -1 ? bearColor : color.gray
    table.cell(dashboard, 0, 1, "Trend", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 1, trendTxt, bgcolor=bg2, text_color=trendClr, text_size=size.small, text_halign=text.align_right)

    // Row 2: Zone
    zoneTxt = inPremium ? "PREMIUM" : "DISCOUNT"
    zoneClr = inPremium ? bearColor : bullColor
    table.cell(dashboard, 0, 2, "Zone", bgcolor=bg1, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 2, zoneTxt, bgcolor=bg1, text_color=zoneClr, text_size=size.small, text_halign=text.align_right)

    // Row 3: Session
    sessionTxt = inLondonKZ ? "LONDON" : inNYKZ ? "NEW YORK" : inAsianKZ ? "ASIAN" : "OFF-SESSION"
    sessionClr = inLondonKZ ? color.new(#2196F3, 0) : inNYKZ ? color.new(#FF9800, 0) : inAsianKZ ? color.new(#9C27B0, 0) : color.gray
    table.cell(dashboard, 0, 3, "Session", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 3, sessionTxt, bgcolor=bg2, text_color=sessionClr, text_size=size.small, text_halign=text.align_right)

    // Row 4: separator
    table.cell(dashboard, 0, 4, "── CONFLUENCE ──", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 4, "", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 4, 1, 4)

    // Row 5: Bull Confluence
    table.cell(dashboard, 0, 5, "Bull Confluence", bgcolor=bg1, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    bcClr = bullConfluence >= minConfluence ? bullColor : color.gray
    table.cell(dashboard, 1, 5, str.tostring(bullConfluence) + " / 6", bgcolor=bg1, text_color=bcClr, text_size=size.small, text_halign=text.align_right)

    // Row 6: Bear Confluence
    table.cell(dashboard, 0, 6, "Bear Confluence", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    brClr = bearConfluence >= minConfluence ? bearColor : color.gray
    table.cell(dashboard, 1, 6, str.tostring(bearConfluence) + " / 6", bgcolor=bg2, text_color=brClr, text_size=size.small, text_halign=text.align_right)

    // Row 7: Active OBs
    table.cell(dashboard, 0, 7, "Active OBs", bgcolor=bg1, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 7, str.tostring(activeBullOB) + "▲ / " + str.tostring(activeBearOB) + "▼", bgcolor=bg1, text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Row 8: Active FVGs
    table.cell(dashboard, 0, 8, "Active FVGs", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 8, str.tostring(activeBullFVG) + "▲ / " + str.tostring(activeBearFVG) + "▼", bgcolor=bg2, text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Row 9: separator
    table.cell(dashboard, 0, 9, "── STATISTICS ──", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 9, "", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 9, 1, 9)

    // Row 10: Total Signals
    table.cell(dashboard, 0, 10, "Total Signals", bgcolor=bg1, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 10, str.tostring(totalSignals), bgcolor=bg1, text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Row 11: Buy/Sell
    table.cell(dashboard, 0, 11, "Buy / Sell", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 11, str.tostring(bullSignals) + " / " + str.tostring(bearSignals), bgcolor=bg2, text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Row 12: Win Rate
    table.cell(dashboard, 0, 12, "Win Rate", bgcolor=bg1, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 12, str.tostring(winRate, "#.#") + "%", bgcolor=bg1, text_color=winClr, text_size=size.small, text_halign=text.align_right)

    // Row 13: Correct / Wrong
    table.cell(dashboard, 0, 13, "Correct / Wrong", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 13, str.tostring(correctSignals) + " / " + str.tostring(incorrectSignals), bgcolor=bg2, text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Row 14: Pending
    table.cell(dashboard, 0, 14, "Pending", bgcolor=bg1, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 14, str.tostring(pendingSignals), bgcolor=bg1, text_color=color.new(#FFC107, 0), text_size=size.small, text_halign=text.align_right)

    // Row 15: Total P/L
    pnlClr = totalPnLPips >= 0 ? color.new(#00E676, 0) : color.new(#FF5252, 0)
    table.cell(dashboard, 0, 15, "Total P/L (Pips)", bgcolor=bg2, text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 15, str.tostring(totalPnLPips, "#.#"), bgcolor=bg2, text_color=pnlClr, text_size=size.small, text_halign=text.align_right)

    // Row 16: separator
    table.cell(dashboard, 0, 16, "── CHECKLIST ──", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 16, "", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 16, 1, 16)

    // Row 17-19: confluence checklist
    checkMS   = bullStructure or bearStructure ? "✓" : "✗"
    checkOB   = atBullOB or atBearOB ? "✓" : "✗"
    checkFVG  = nearBullFVG or nearBearFVG ? "✓" : "✗"
    checkZone = (inDiscount and trendDir == 1) or (inPremium and trendDir == -1) ? "✓" : "✗"
    checkLiq  = sweepBSL or sweepSSL ? "✓" : "✗"
    checkKZ   = inActiveKZ ? "✓" : "✗"

    msClr   = bullStructure or bearStructure ? bullColor : color.new(#FF5252, 0)
    obClr   = atBullOB or atBearOB ? bullColor : color.new(#FF5252, 0)
    fvgClr  = nearBullFVG or nearBearFVG ? bullColor : color.new(#FF5252, 0)
    zoneClr2 = (inDiscount and trendDir == 1) or (inPremium and trendDir == -1) ? bullColor : color.new(#FF5252, 0)
    liqClr  = sweepBSL or sweepSSL ? bullColor : color.new(#FF5252, 0)
    kzClr   = inActiveKZ ? bullColor : color.new(#FF5252, 0)

    table.cell(dashboard, 0, 17, checkMS + " Market Structure", bgcolor=bg1, text_color=msClr, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dashboard, 1, 17, checkOB + " Order Block", bgcolor=bg1, text_color=obClr, text_size=size.tiny, text_halign=text.align_right)
    table.cell(dashboard, 0, 18, checkFVG + " FVG", bgcolor=bg2, text_color=fvgClr, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dashboard, 1, 18, checkZone + " P/D Zone", bgcolor=bg2, text_color=zoneClr2, text_size=size.tiny, text_halign=text.align_right)
    table.cell(dashboard, 0, 19, checkLiq + " Liq Sweep", bgcolor=bg1, text_color=liqClr, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dashboard, 1, 19, checkKZ + " Kill Zone", bgcolor=bg1, text_color=kzClr, text_size=size.tiny, text_halign=text.align_right)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(newBullSignal, "SMC Buy Signal", "BUY Signal | Confluence: " + str.tostring(bullConfluence) + "/6")
alertcondition(newBearSignal, "SMC Sell Signal", "SELL Signal | Confluence: " + str.tostring(bearConfluence) + "/6")
alertcondition(newBullSignal or newBearSignal, "Any SMC Signal", "SMC Signal Detected")
alertcondition(sweepBSL, "BSL Sweep", "Buy Side Liquidity Swept")
alertcondition(sweepSSL, "SSL Sweep", "Sell Side Liquidity Swept")
alertcondition(chochUp or chochDn, "CHoCH Detected", "Change of Character Detected")
alertcondition(bosUp or bosDn, "BOS Detected", "Break of Structure Detected")

// Hidden plots
plot(trendDir, "Trend Direction", display=display.none)
plot(bullConfluence, "Bull Confluence", display=display.none)
plot(bearConfluence, "Bear Confluence", display=display.none)
