//@version=6
indicator("Multi-Factor Price Predictor [Forex]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================
// INPUTS
// ============================================================================

// — General Settings —
g_general        = "══════ General Settings ══════"
predBars         = input.int(5, "Prediction Horizon (Bars)", minval=1, maxval=50, group=g_general)
minConfidence    = input.float(50.0, "Min Confidence to Show Signal (%)", minval=10, maxval=95, step=5, group=g_general)

// — Anchored VWAP —
g_vwap           = "══════ Anchored VWAP ══════"
useVwap          = input.bool(true, "Enable VWAP Analysis", group=g_vwap)
vwapWeight       = input.float(15.0, "VWAP Weight (%)", minval=0, maxval=100, step=5, group=g_vwap)
vwapAnchorLen    = input.int(50, "VWAP Anchor Length", minval=10, maxval=200, group=g_vwap)

// — Order Block & FVG —
g_ob             = "══════ Order Block & FVG ══════"
useOB            = input.bool(true, "Enable Order Block & FVG", group=g_ob)
obWeight         = input.float(15.0, "OB/FVG Weight (%)", minval=0, maxval=100, step=5, group=g_ob)
obLookback       = input.int(20, "OB Lookback Length", minval=5, maxval=100, group=g_ob)

// — Price Action —
g_pa             = "══════ Price Action ══════"
usePA            = input.bool(true, "Enable Price Action", group=g_pa)
paWeight         = input.float(15.0, "Price Action Weight (%)", minval=0, maxval=100, step=5, group=g_pa)

// — Support & Resistance —
g_sr             = "══════ Support & Resistance ══════"
useSR            = input.bool(true, "Enable Support & Resistance", group=g_sr)
srWeight         = input.float(15.0, "S/R Weight (%)", minval=0, maxval=100, step=5, group=g_sr)
srLookback       = input.int(50, "S/R Lookback Length", minval=10, maxval=200, group=g_sr)
srZoneATRMult    = input.float(0.3, "S/R Zone Width (ATR mult)", minval=0.1, maxval=1.0, step=0.1, group=g_sr)

// — Fibonacci —
g_fib            = "══════ Fibonacci ══════"
useFib           = input.bool(true, "Enable Fibonacci", group=g_fib)
fibWeight        = input.float(10.0, "Fibonacci Weight (%)", minval=0, maxval=100, step=5, group=g_fib)
fibLookback      = input.int(50, "Fibonacci Lookback", minval=10, maxval=200, group=g_fib)

// — RSI & Divergence —
g_rsi            = "══════ RSI & Divergence ══════"
useRSI           = input.bool(true, "Enable RSI Divergence", group=g_rsi)
rsiWeight        = input.float(10.0, "RSI Weight (%)", minval=0, maxval=100, step=5, group=g_rsi)
rsiLen           = input.int(14, "RSI Length", minval=5, maxval=50, group=g_rsi)

// — EMA Ribbon —
g_ema            = "══════ EMA Ribbon ══════"
useEMA           = input.bool(true, "Enable EMA Ribbon", group=g_ema)
emaWeight        = input.float(10.0, "EMA Weight (%)", minval=0, maxval=100, step=5, group=g_ema)

// — Volume & ATR —
g_vol            = "══════ Volume & ATR ══════"
useVol           = input.bool(true, "Enable Volume Analysis", group=g_vol)
volWeight        = input.float(5.0, "Volume Weight (%)", minval=0, maxval=100, step=5, group=g_vol)
atrLen           = input.int(14, "ATR Length", minval=5, maxval=50, group=g_vol)

// — Stochastic RSI —
g_stoch          = "══════ Stochastic RSI ══════"
useStoch         = input.bool(true, "Enable Stochastic RSI", group=g_stoch)
stochWeight      = input.float(5.0, "Stoch RSI Weight (%)", minval=0, maxval=100, step=5, group=g_stoch)
stochLen         = input.int(14, "Stoch RSI Length", minval=5, maxval=50, group=g_stoch)
stochSmK         = input.int(3, "Stoch %K Smoothing", minval=1, maxval=10, group=g_stoch)
stochSmD         = input.int(3, "Stoch %D Smoothing", minval=1, maxval=10, group=g_stoch)

// — Visual Settings —
g_visual         = "══════ Visual Settings ══════"
showDashboard    = input.bool(true, "Show Statistics Dashboard", group=g_visual)
showSRZones      = input.bool(true, "Show S/R Zones", group=g_visual)
showOBZones      = input.bool(true, "Show Order Block Zones", group=g_visual)
showFVGZones     = input.bool(true, "Show FVG Zones", group=g_visual)
bullColor        = input.color(color.new(#00E676, 0), "Bullish Color", group=g_visual)
bearColor        = input.color(color.new(#FF5252, 0), "Bearish Color", group=g_visual)
dashboardPos     = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=g_visual)

// ============================================================================
// CORE CALCULATIONS
// ============================================================================

// — ATR (used across multiple modules) —
atrVal           = ta.atr(atrLen)

// ============================================================================
// MODULE 1: ANCHORED VWAP
// ============================================================================
f_vwapScore() =>
    float score = 0.0
    if useVwap
        // Calculate rolling VWAP using anchor length
        vwapSum      = math.sum(close * volume, vwapAnchorLen)
        volSum       = math.sum(volume, vwapAnchorLen)
        anchoredVwap = volSum != 0 ? vwapSum / volSum : close

        // Price position relative to VWAP
        vwapDist     = (close - anchoredVwap) / atrVal
        vwapSlope    = anchoredVwap - anchoredVwap[3]

        // Bullish: price above VWAP and VWAP rising
        if close > anchoredVwap and vwapSlope > 0
            score := math.min(vwapDist * 25, 100)
        else if close < anchoredVwap and vwapSlope < 0
            score := math.max(vwapDist * 25, -100)
        else
            // Mixed signal — less conviction
            score := vwapDist * 10
    score

// ============================================================================
// MODULE 2: ORDER BLOCK & FVG DETECTION
// ============================================================================
var float lastBullOBTop    = na
var float lastBullOBBot    = na
var float lastBearOBTop    = na
var float lastBearOBBot    = na
var float lastBullFVGTop   = na
var float lastBullFVGBot   = na
var float lastBearFVGTop   = na
var float lastBearFVGBot   = na
var int   lastBullOBBar    = na
var int   lastBearOBBar    = na
var int   lastBullFVGBar   = na
var int   lastBearFVGBar   = na

// — Order Blocks (global scope) —
// Bullish OB: last bearish candle before a strong bullish move
bullOB = close[1] < open[1] and close > open and (close - open) > atrVal * 1.0
if bullOB
    lastBullOBTop  := open[1]
    lastBullOBBot  := close[1]
    lastBullOBBar  := bar_index

// Bearish OB: last bullish candle before a strong bearish move
bearOB = close[1] > open[1] and close < open and (open - close) > atrVal * 1.0
if bearOB
    lastBearOBTop  := close[1]
    lastBearOBBot  := open[1]
    lastBearOBBar  := bar_index

// — Fair Value Gaps (global scope) —
// Bullish FVG: gap between candle [2] high and candle [0] low
bullFVG = low > high[2] and close > open
if bullFVG
    lastBullFVGTop := low
    lastBullFVGBot := high[2]
    lastBullFVGBar := bar_index

// Bearish FVG: gap between candle [0] high and candle [2] low
bearFVG = high < low[2] and close < open
if bearFVG
    lastBearFVGTop := low[2]
    lastBearFVGBot := high
    lastBearFVGBar := bar_index

f_obfvgScore() =>
    float score = 0.0
    if useOB
        freshness = obLookback
        // Bullish OB proximity
        if not na(lastBullOBTop) and (bar_index - lastBullOBBar) < freshness
            if close >= lastBullOBBot and close <= lastBullOBTop
                score += 60  // Price is in bullish OB zone
            else if close > lastBullOBTop and close < lastBullOBTop + atrVal
                score += 30  // Price just above bullish OB
        // Bearish OB proximity
        if not na(lastBearOBTop) and (bar_index - lastBearOBBar) < freshness
            if close >= lastBearOBBot and close <= lastBearOBTop
                score -= 60
            else if close < lastBearOBBot and close > lastBearOBBot - atrVal
                score -= 30

        // FVG scoring — unfilled gaps act as magnets
        if not na(lastBullFVGTop) and (bar_index - lastBullFVGBar) < freshness
            if close <= lastBullFVGTop and close >= lastBullFVGBot
                score += 40  // Price filling bullish FVG
            else if close < lastBullFVGBot
                score += 20  // Bullish FVG above — magnet effect
        if not na(lastBearFVGTop) and (bar_index - lastBearFVGBar) < freshness
            if close >= lastBearFVGBot and close <= lastBearFVGTop
                score -= 40
            else if close > lastBearFVGTop
                score -= 20

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 3: PRICE ACTION
// ============================================================================
f_paScore() =>
    float score = 0.0
    if usePA
        bodySize     = math.abs(close - open)
        upperWick    = high - math.max(close, open)
        lowerWick    = math.min(close, open) - low
        totalRange   = high - low
        bodyRatio    = totalRange != 0 ? bodySize / totalRange : 0

        // — Engulfing —
        bullEngulf   = close[1] < open[1] and close > open and close > open[1] and open < close[1]
        bearEngulf   = close[1] > open[1] and close < open and close < open[1] and open > close[1]
        if bullEngulf
            score += 50
        if bearEngulf
            score -= 50

        // — Pin Bar / Hammer —
        isHammer     = lowerWick > bodySize * 2 and upperWick < bodySize * 0.5 and bodyRatio < 0.4
        isShooter    = upperWick > bodySize * 2 and lowerWick < bodySize * 0.5 and bodyRatio < 0.4
        if isHammer
            score += 40
        if isShooter
            score -= 40

        // — Doji (indecision) —
        isDoji       = bodyRatio < 0.1 and totalRange > atrVal * 0.5
        if isDoji
            score *= 0.5  // Reduce conviction on doji

        // — Three consecutive candles (momentum) —
        threeUp      = close > close[1] and close[1] > close[2] and close[2] > close[3]
        threeDn      = close < close[1] and close[1] < close[2] and close[2] < close[3]
        if threeUp
            score += 30
        if threeDn
            score -= 30

        // — Morning/Evening Star patterns —
        morningStar  = close[2] < open[2] and math.abs(close[1] - open[1]) < atrVal * 0.3 and close > open and close > (open[2] + close[2]) / 2
        eveningStar  = close[2] > open[2] and math.abs(close[1] - open[1]) < atrVal * 0.3 and close < open and close < (open[2] + close[2]) / 2
        if morningStar
            score += 45
        if eveningStar
            score -= 45

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 4: SUPPORT & RESISTANCE
// ============================================================================
f_srScore() =>
    float score = 0.0
    if useSR
        pivotHigh    = ta.pivothigh(high, srLookback / 2, srLookback / 2)
        pivotLow     = ta.pivotlow(low, srLookback / 2, srLookback / 2)

        // Find nearest support and resistance
        var float nearestRes = na
        var float nearestSup = na

        if not na(pivotHigh)
            nearestRes := pivotHigh
        if not na(pivotLow)
            nearestSup := pivotLow

        zoneWidth = atrVal * srZoneATRMult

        // Proximity scoring
        if not na(nearestRes)
            distToRes = nearestRes - close
            if distToRes > 0 and distToRes < zoneWidth * 2
                score -= 40  // Near resistance — bearish pressure
            else if distToRes < 0 and math.abs(distToRes) < zoneWidth
                score += 30  // Just broke resistance — bullish

        if not na(nearestSup)
            distToSup = close - nearestSup
            if distToSup > 0 and distToSup < zoneWidth * 2
                score += 40  // Near support — bullish bounce
            else if distToSup < 0 and math.abs(distToSup) < zoneWidth
                score -= 30  // Just broke support — bearish

        // Price position between S/R
        if not na(nearestRes) and not na(nearestSup) and nearestRes > nearestSup
            srRange    = nearestRes - nearestSup
            position   = srRange != 0 ? (close - nearestSup) / srRange : 0.5
            // Near top of range = bearish bias, near bottom = bullish
            score     += (0.5 - position) * 40

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 5: FIBONACCI
// ============================================================================
f_fibScore() =>
    float score = 0.0
    if useFib
        highestH = ta.highest(high, fibLookback)
        lowestL  = ta.lowest(low, fibLookback)
        fibRange = highestH - lowestL

        if fibRange > 0
            // Determine trend direction for fib
            highBar  = ta.highestbars(high, fibLookback)
            lowBar   = ta.lowestbars(low, fibLookback)
            uptrend  = lowBar < highBar  // Low came first = uptrend

            float fib236 = na
            float fib382 = na
            float fib500 = na
            float fib618 = na
            float fib786 = na

            if uptrend
                fib236 := highestH - fibRange * 0.236
                fib382 := highestH - fibRange * 0.382
                fib500 := highestH - fibRange * 0.500
                fib618 := highestH - fibRange * 0.618
                fib786 := highestH - fibRange * 0.786
            else
                fib236 := lowestL + fibRange * 0.236
                fib382 := lowestL + fibRange * 0.382
                fib500 := lowestL + fibRange * 0.500
                fib618 := lowestL + fibRange * 0.618
                fib786 := lowestL + fibRange * 0.786

            // Check proximity to fib levels
            tolerance = atrVal * 0.3
            nearFib   = false
            fibLevel  = ""

            if math.abs(close - fib236) < tolerance
                nearFib  := true
                fibLevel := "23.6%"
            if math.abs(close - fib382) < tolerance
                nearFib  := true
                fibLevel := "38.2%"
            if math.abs(close - fib500) < tolerance
                nearFib  := true
                fibLevel := "50%"
            if math.abs(close - fib618) < tolerance
                nearFib  := true
                fibLevel := "61.8%"
            if math.abs(close - fib786) < tolerance
                nearFib  := true
                fibLevel := "78.6%"

            if nearFib
                if uptrend
                    // At fib retracement in uptrend = potential bounce (bullish)
                    score += 50
                else
                    // At fib retracement in downtrend = potential bounce (bearish)
                    score -= 50
            else
                // Not near any fib level — neutral with slight trend bias
                if uptrend
                    score += 10
                else
                    score -= 10

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 6: RSI DIVERGENCE
// ============================================================================
f_rsiScore() =>
    float score = 0.0
    if useRSI
        rsiVal       = ta.rsi(close, rsiLen)

        // RSI level scoring
        if rsiVal > 70
            score -= 30  // Overbought
        else if rsiVal < 30
            score += 30  // Oversold
        else if rsiVal > 50
            score += (rsiVal - 50) * 0.5
        else
            score -= (50 - rsiVal) * 0.5

        // Divergence detection (5-bar lookback)
        priceMakesHigherHigh = high > ta.highest(high, 10)[1]
        rsiMakesLowerHigh    = rsiVal < ta.highest(rsiVal, 10)[1]
        priceMakesLowerLow   = low < ta.lowest(low, 10)[1]
        rsiMakesHigherLow    = rsiVal > ta.lowest(rsiVal, 10)[1]

        // Bearish divergence
        if priceMakesHigherHigh and rsiMakesLowerHigh
            score -= 40

        // Bullish divergence
        if priceMakesLowerLow and rsiMakesHigherLow
            score += 40

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 7: EMA RIBBON
// ============================================================================
f_emaScore() =>
    float score = 0.0
    if useEMA
        ema21  = ta.ema(close, 21)
        ema50  = ta.ema(close, 50)
        ema200 = ta.ema(close, 200)

        // Trend alignment
        if ema21 > ema50 and ema50 > ema200
            score += 60  // Perfect bullish alignment
        else if ema21 < ema50 and ema50 < ema200
            score -= 60  // Perfect bearish alignment
        else if ema21 > ema50
            score += 25  // Short-term bullish
        else if ema21 < ema50
            score -= 25  // Short-term bearish

        // Price position relative to EMAs
        if close > ema21 and close > ema50 and close > ema200
            score += 30
        else if close < ema21 and close < ema50 and close < ema200
            score -= 30

        // EMA slope (momentum)
        ema21Slope = ema21 - ema21[3]
        if ema21Slope > 0
            score += 10
        else
            score -= 10

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 8: VOLUME ANALYSIS
// ============================================================================
f_volScore() =>
    float score = 0.0
    if useVol
        avgVol       = ta.sma(volume, 20)
        volRatio     = avgVol != 0 ? volume / avgVol : 1.0
        isHighVol    = volRatio > 1.5

        // High volume confirms direction
        if isHighVol
            if close > open
                score += 50  // High volume bullish
            else
                score -= 50  // High volume bearish
        else if volRatio < 0.5
            // Low volume — less conviction
            score *= 0.3

        // Volume trend
        volSma5  = ta.sma(volume, 5)
        volSma20 = ta.sma(volume, 20)
        if volSma5 > volSma20
            if close > close[5]
                score += 20  // Rising volume in uptrend
            else
                score -= 20
        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// MODULE 9: STOCHASTIC RSI
// ============================================================================
f_stochScore() =>
    float score = 0.0
    if useStoch
        rsiVal   = ta.rsi(close, stochLen)
        stochRsi = ta.stoch(rsiVal, rsiVal, rsiVal, stochLen)
        k        = ta.sma(stochRsi, stochSmK)
        d        = ta.sma(k, stochSmD)

        // Overbought/Oversold
        if k < 20 and d < 20
            score += 40  // Oversold
            if k > d
                score += 20  // Bullish crossover in oversold
        else if k > 80 and d > 80
            score -= 40  // Overbought
            if k < d
                score -= 20  // Bearish crossover in overbought

        // Crossovers in neutral zone
        if k > d and k[1] <= d[1] and k > 20 and k < 80
            score += 25
        if k < d and k[1] >= d[1] and k > 20 and k < 80
            score -= 25

        score := math.max(-100, math.min(100, score))
    score

// ============================================================================
// PREDICTION ENGINE
// ============================================================================

// Calculate individual scores
vwapScore  = f_vwapScore()
obScore    = f_obfvgScore()
paScore    = f_paScore()
srScore    = f_srScore()
fibScore   = f_fibScore()
rsiScore   = f_rsiScore()
emaScore   = f_emaScore()
volScore   = f_volScore()
stochScore = f_stochScore()

// Calculate total weight (only from enabled modules)
totalWeight = (useVwap ? vwapWeight : 0) + (useOB ? obWeight : 0) + (usePA ? paWeight : 0) + (useSR ? srWeight : 0) + (useFib ? fibWeight : 0) + (useRSI ? rsiWeight : 0) + (useEMA ? emaWeight : 0) + (useVol ? volWeight : 0) + (useStoch ? stochWeight : 0)

// Weighted composite score
compositeScore = totalWeight > 0 ? ((vwapScore * (useVwap ? vwapWeight : 0)) + (obScore * (useOB ? obWeight : 0)) + (paScore * (usePA ? paWeight : 0)) + (srScore * (useSR ? srWeight : 0)) + (fibScore * (useFib ? fibWeight : 0)) + (rsiScore * (useRSI ? rsiWeight : 0)) + (emaScore * (useEMA ? emaWeight : 0)) + (volScore * (useVol ? volWeight : 0)) + (stochScore * (useStoch ? stochWeight : 0))) / totalWeight : 0

// Direction and confidence
isBullish  = compositeScore > 0
isBearish  = compositeScore < 0

// Confidence: number of modules agreeing with the direction
agreeBull  = (vwapScore > 0 and useVwap ? 1 : 0) + (obScore > 0 and useOB ? 1 : 0) + (paScore > 0 and usePA ? 1 : 0) + (srScore > 0 and useSR ? 1 : 0) + (fibScore > 0 and useFib ? 1 : 0) + (rsiScore > 0 and useRSI ? 1 : 0) + (emaScore > 0 and useEMA ? 1 : 0) + (volScore > 0 and useVol ? 1 : 0) + (stochScore > 0 and useStoch ? 1 : 0)
agreeBear  = (vwapScore < 0 and useVwap ? 1 : 0) + (obScore < 0 and useOB ? 1 : 0) + (paScore < 0 and usePA ? 1 : 0) + (srScore < 0 and useSR ? 1 : 0) + (fibScore < 0 and useFib ? 1 : 0) + (rsiScore < 0 and useRSI ? 1 : 0) + (emaScore < 0 and useEMA ? 1 : 0) + (volScore < 0 and useVol ? 1 : 0) + (stochScore < 0 and useStoch ? 1 : 0)
enabledCount = (useVwap ? 1 : 0) + (useOB ? 1 : 0) + (usePA ? 1 : 0) + (useSR ? 1 : 0) + (useFib ? 1 : 0) + (useRSI ? 1 : 0) + (useEMA ? 1 : 0) + (useVol ? 1 : 0) + (useStoch ? 1 : 0)

// Agreement ratio as confidence factor
agreeRatio    = enabledCount > 0 ? math.max(agreeBull, agreeBear) / enabledCount : 0
scoreStrength = math.min(math.abs(compositeScore) / 60, 1.0)  // Normalize score strength

// Final confidence: blend of agreement ratio and score strength
confidence    = math.round((agreeRatio * 60 + scoreStrength * 40), 1)

// Prediction target price
predictionATR = atrVal * predBars * 0.5  // Expected move based on ATR
targetPrice   = isBullish ? close + predictionATR * (confidence / 100) : close - predictionATR * (confidence / 100)

// Signal conditions
showSignal    = confidence >= minConfidence and enabledCount >= 3
newSignal     = showSignal and (not showSignal[1] or (isBullish != isBullish[1]))

// ============================================================================
// STATISTICS TRACKING
// ============================================================================
var int   totalSignals     = 0
var int   bullSignals      = 0
var int   bearSignals      = 0
var int   correctSignals   = 0
var int   incorrectSignals = 0
var int   pendingSignals   = 0
var float totalPnLPips     = 0.0
var float avgConfidence    = 0.0
var float sumConfidence    = 0.0

// Arrays to track predictions for validation
var array<float> predPrices      = array.new_float(0)
var array<int>   predBarsArr     = array.new_int(0)
var array<bool>  predDirections  = array.new_bool(0)   // true=bull, false=bear
var array<float> predEntries     = array.new_float(0)
var array<float> predConfidences = array.new_float(0)

// Record new signals
if newSignal
    totalSignals  += 1
    pendingSignals += 1
    sumConfidence += confidence
    avgConfidence := totalSignals > 0 ? sumConfidence / totalSignals : 0

    if isBullish
        bullSignals += 1
    else
        bearSignals += 1

    array.push(predPrices, targetPrice)
    array.push(predBarsArr, bar_index + predBars)
    array.push(predDirections, isBullish)
    array.push(predEntries, close)
    array.push(predConfidences, confidence)

// Validate past predictions
if array.size(predBarsArr) > 0
    int removeCount = 0
    for i = 0 to math.min(array.size(predBarsArr) - 1, 49)
        if bar_index >= array.get(predBarsArr, i)
            entryPrice  = array.get(predEntries, i)
            wasBull     = array.get(predDirections, i)
            priceDiff   = close - entryPrice

            isCorrect   = (wasBull and priceDiff > 0) or (not wasBull and priceDiff < 0)

            if isCorrect
                correctSignals += 1
            else
                incorrectSignals += 1

            pendingSignals -= 1
            pipMultiplier   = syminfo.mintick != 0 ? 1 / syminfo.mintick : 10000
            pnlPips         = math.abs(priceDiff) * pipMultiplier * (isCorrect ? 1 : -1)
            totalPnLPips   += pnlPips

            removeCount += 1

    // Remove validated predictions (from the front)
    if removeCount > 0
        for j = 1 to removeCount
            if array.size(predBarsArr) > 0
                array.shift(predPrices)
                array.shift(predBarsArr)
                array.shift(predDirections)
                array.shift(predEntries)
                array.shift(predConfidences)

winRate = (correctSignals + incorrectSignals) > 0 ? math.round(correctSignals / (correctSignals + incorrectSignals) * 100, 1) : 0.0

// ============================================================================
// VISUAL RENDERING
// ============================================================================

// — Prediction Arrow (Dashed Line + Arrow Label) —
var line  predLine  = na
var label predLabel = na
var label entryLabel = na

// Clean up previous drawings
if not na(predLine)
    line.delete(predLine)
if not na(predLabel)
    label.delete(predLabel)
if not na(entryLabel)
    label.delete(entryLabel)

if showSignal and barstate.islast
    lineColor   = isBullish ? bullColor : bearColor
    arrowChar   = isBullish ? "▲" : "▼"
    labelY      = targetPrice
    signalText  = (isBullish ? "BUY" : "SELL") + "\n" + str.tostring(confidence, "#.#") + "% Confidence" + "\nTarget: " + str.tostring(targetPrice, "#.#####")

    // Dashed prediction line from last candle to target
    predLine := line.new(
         bar_index, close,
         bar_index + predBars, targetPrice,
         color=lineColor,
         style=line.style_dashed,
         width=2)

    // Arrow label at target
    predLabel := label.new(
         bar_index + predBars, targetPrice,
         arrowChar + "\n" + signalText,
         color=color.new(lineColor, 80),
         textcolor=lineColor,
         style=isBullish ? label.style_label_up : label.style_label_down,
         size=size.normal)

    // Entry point label
    entryLabel := label.new(
         bar_index, close,
         "●",
         color=color.new(lineColor, 90),
         textcolor=lineColor,
         style=label.style_label_center,
         size=size.small)

// — Signal markers on chart —
plotshape(newSignal and isBullish, "Buy Signal", shape.triangleup, location.belowbar, bullColor, size=size.small)
plotshape(newSignal and isBearish, "Sell Signal", shape.triangledown, location.abovebar, bearColor, size=size.small)

// — S/R Zone Boxes —
var box supBox = na
var box resBox = na

if showSRZones and barstate.islast
    if not na(supBox)
        box.delete(supBox)
    if not na(resBox)
        box.delete(resBox)

    pivotHigh_sr = ta.pivothigh(high, srLookback / 2, srLookback / 2)
    pivotLow_sr  = ta.pivotlow(low, srLookback / 2, srLookback / 2)

    if not na(pivotHigh_sr)
        zw = atrVal * srZoneATRMult
        resBox := box.new(bar_index - srLookback, pivotHigh_sr + zw, bar_index + 5, pivotHigh_sr - zw, border_color=color.new(bearColor, 60), bgcolor=color.new(bearColor, 90))

    if not na(pivotLow_sr)
        zw = atrVal * srZoneATRMult
        supBox := box.new(bar_index - srLookback, pivotLow_sr + zw, bar_index + 5, pivotLow_sr - zw, border_color=color.new(bullColor, 60), bgcolor=color.new(bullColor, 90))

// — Order Block Zone Boxes —
var box bullOBBox = na
var box bearOBBox = na

if showOBZones and barstate.islast
    if not na(bullOBBox)
        box.delete(bullOBBox)
    if not na(bearOBBox)
        box.delete(bearOBBox)

    if not na(lastBullOBTop) and (bar_index - lastBullOBBar) < obLookback
        bullOBBox := box.new(lastBullOBBar, lastBullOBTop, bar_index + 5, lastBullOBBot, border_color=color.new(bullColor, 50), bgcolor=color.new(bullColor, 85), text="Bull OB", text_color=bullColor, text_size=size.tiny)

    if not na(lastBearOBTop) and (bar_index - lastBearOBBar) < obLookback
        bearOBBox := box.new(lastBearOBBar, lastBearOBTop, bar_index + 5, lastBearOBBot, border_color=color.new(bearColor, 50), bgcolor=color.new(bearColor, 85), text="Bear OB", text_color=bearColor, text_size=size.tiny)

// — FVG Zone Boxes —
var box bullFVGBox = na
var box bearFVGBox = na

if showFVGZones and barstate.islast
    if not na(bullFVGBox)
        box.delete(bullFVGBox)
    if not na(bearFVGBox)
        box.delete(bearFVGBox)

    if not na(lastBullFVGTop) and (bar_index - lastBullFVGBar) < obLookback
        bullFVGBox := box.new(lastBullFVGBar, lastBullFVGTop, bar_index + 5, lastBullFVGBot, border_color=color.new(#2196F3, 50), bgcolor=color.new(#2196F3, 88), text="Bull FVG", text_color=#2196F3, text_size=size.tiny)

    if not na(lastBearFVGTop) and (bar_index - lastBearFVGBar) < obLookback
        bearFVGBox := box.new(lastBearFVGBar, lastBearFVGTop, bar_index + 5, lastBearFVGBot, border_color=color.new(#FF9800, 50), bgcolor=color.new(#FF9800, 88), text="Bear FVG", text_color=#FF9800, text_size=size.tiny)

// ============================================================================
// HELPER FUNCTIONS FOR DASHBOARD
// ============================================================================
f_scoreColor(s) =>
    s > 20 ? color.new(#00E676, 0) : s < -20 ? color.new(#FF5252, 0) : color.new(#FFC107, 0)

f_scoreIcon(s) =>
    s > 20 ? "▲ " : s < -20 ? "▼ " : "◆ "

// ============================================================================
// STATISTICS DASHBOARD
// ============================================================================
if showDashboard and barstate.islast
    // Dashboard position
    dashX = switch dashboardPos
        "Top Right"    => bar_index + 20
        "Top Left"     => bar_index - 100
        "Bottom Right"  => bar_index + 20
        "Bottom Left"   => bar_index - 100
        => bar_index + 20

    dashY = switch dashboardPos
        "Top Right"    => ta.highest(high, 50) + atrVal * 3
        "Top Left"     => ta.highest(high, 50) + atrVal * 3
        "Bottom Right"  => ta.lowest(low, 50) - atrVal * 3
        "Bottom Left"   => ta.lowest(low, 50) - atrVal * 3
        => ta.highest(high, 50) + atrVal * 3

    var table dashboard = table.new(position.top_right, 2, 22, bgcolor=color.new(#1a1a2e, 10), border_color=color.new(#ffffff, 80), border_width=1, frame_color=color.new(#ffffff, 80), frame_width=1)

    // Helper colors
    headerBg   = color.new(#16213e, 0)
    headerTxt  = color.new(#e94560, 0)
    labelTxt   = color.new(#a2a2b5, 0)
    valueTxt   = color.new(#ffffff, 0)
    winColor   = winRate >= 50 ? color.new(#00E676, 0) : color.new(#FF5252, 0)

    // Title
    table.cell(dashboard, 0, 0, "PRICE PREDICTOR", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 0, "DASHBOARD", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 0, 1, 0)

    // Current Signal
    sigColor = showSignal ? (isBullish ? bullColor : bearColor) : color.gray
    sigText  = showSignal ? (isBullish ? "◆ BUY" : "◆ SELL") : "◆ NO SIGNAL"
    table.cell(dashboard, 0, 1, "Signal", bgcolor=color.new(#0f3460, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 1, sigText, bgcolor=color.new(#0f3460, 0), text_color=sigColor, text_size=size.small, text_halign=text.align_right)

    // Confidence
    table.cell(dashboard, 0, 2, "Confidence", bgcolor=color.new(#1a1a2e, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    confColor = confidence >= 70 ? color.new(#00E676, 0) : confidence >= 50 ? color.new(#FFC107, 0) : color.new(#FF5252, 0)
    table.cell(dashboard, 1, 2, str.tostring(confidence, "#.#") + "%", bgcolor=color.new(#1a1a2e, 0), text_color=confColor, text_size=size.small, text_halign=text.align_right)

    // Target Price
    table.cell(dashboard, 0, 3, "Target Price", bgcolor=color.new(#0f3460, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 3, showSignal ? str.tostring(targetPrice, "#.#####") : "—", bgcolor=color.new(#0f3460, 0), text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Separator
    table.cell(dashboard, 0, 4, "── STATISTICS ──", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 4, "", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 4, 1, 4)

    // Total Signals
    table.cell(dashboard, 0, 5, "Total Signals", bgcolor=color.new(#1a1a2e, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 5, str.tostring(totalSignals), bgcolor=color.new(#1a1a2e, 0), text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Buy / Sell
    table.cell(dashboard, 0, 6, "Buy / Sell", bgcolor=color.new(#0f3460, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 6, str.tostring(bullSignals) + " / " + str.tostring(bearSignals), bgcolor=color.new(#0f3460, 0), text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Win Rate
    table.cell(dashboard, 0, 7, "Win Rate", bgcolor=color.new(#1a1a2e, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 7, str.tostring(winRate, "#.#") + "%", bgcolor=color.new(#1a1a2e, 0), text_color=winColor, text_size=size.small, text_halign=text.align_right)

    // Correct / Incorrect
    table.cell(dashboard, 0, 8, "Correct / Wrong", bgcolor=color.new(#0f3460, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 8, str.tostring(correctSignals) + " / " + str.tostring(incorrectSignals), bgcolor=color.new(#0f3460, 0), text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Pending
    table.cell(dashboard, 0, 9, "Pending", bgcolor=color.new(#1a1a2e, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 9, str.tostring(pendingSignals), bgcolor=color.new(#1a1a2e, 0), text_color=color.new(#FFC107, 0), text_size=size.small, text_halign=text.align_right)

    // Total P/L (Pips)
    table.cell(dashboard, 0, 10, "Total P/L (Pips)", bgcolor=color.new(#0f3460, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    pnlColor = totalPnLPips >= 0 ? color.new(#00E676, 0) : color.new(#FF5252, 0)
    table.cell(dashboard, 1, 10, str.tostring(totalPnLPips, "#.#"), bgcolor=color.new(#0f3460, 0), text_color=pnlColor, text_size=size.small, text_halign=text.align_right)

    // Avg Confidence
    table.cell(dashboard, 0, 11, "Avg Confidence", bgcolor=color.new(#1a1a2e, 0), text_color=labelTxt, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 11, str.tostring(avgConfidence, "#.#") + "%", bgcolor=color.new(#1a1a2e, 0), text_color=valueTxt, text_size=size.small, text_halign=text.align_right)

    // Module Scores Header
    table.cell(dashboard, 0, 12, "── MODULE SCORES ──", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.cell(dashboard, 1, 12, "", bgcolor=headerBg, text_color=headerTxt, text_size=size.small)
    table.merge_cells(dashboard, 0, 12, 1, 12)

    // Module breakdown
    moduleNames  = array.from("VWAP", "OB/FVG", "PriceAct", "S/R", "Fib", "RSI", "EMA", "Volume", "StochRSI")
    moduleScores = array.from(vwapScore, obScore, paScore, srScore, fibScore, rsiScore, emaScore, volScore, stochScore)
    moduleOn     = array.from(useVwap, useOB, usePA, useSR, useFib, useRSI, useEMA, useVol, useStoch)

    row = 13
    for i = 0 to 8
        if array.get(moduleOn, i)
            sc = array.get(moduleScores, i)
            bg = i % 2 == 0 ? color.new(#1a1a2e, 0) : color.new(#0f3460, 0)
            table.cell(dashboard, 0, row, array.get(moduleNames, i), bgcolor=bg, text_color=labelTxt, text_size=size.tiny, text_halign=text.align_left)
            table.cell(dashboard, 1, row, f_scoreIcon(sc) + str.tostring(sc, "#.#"), bgcolor=bg, text_color=f_scoreColor(sc), text_size=size.tiny, text_halign=text.align_right)
            row += 1

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(newSignal and isBullish, "Bullish Prediction", "BUY Signal | Confidence: {{plot_0}}% | Target: {{plot_1}}")
alertcondition(newSignal and isBearish, "Bearish Prediction", "SELL Signal | Confidence: {{plot_0}}% | Target: {{plot_1}}")
alertcondition(newSignal, "Any Prediction Signal", "{{plot_2}} Signal | Confidence: {{plot_0}}% | Target: {{plot_1}}")

// Hidden plots for alerts
plot(confidence, "Confidence", display=display.none)
plot(targetPrice, "Target Price", display=display.none)
plot(isBullish ? 1 : -1, "Direction", display=display.none)
plot(compositeScore, "Composite Score", display=display.none)
